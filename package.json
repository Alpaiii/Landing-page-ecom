{
  "name": "roquace",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"tsx watch --tsconfig server/tsconfig.json server/src/index.ts\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "astro build",
    "build:backend": "tsc -p server/tsconfig.json",
    "start": "node server/scripts/migrate.js && node server/scripts/seed.js && node server/dist/index.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "railway": "npm run build && npm run migrate && npm run seed && npm start"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/tailwind": "^6.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.0",
    "astro": "^5.7.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^0.469.0",
    "multer": "^2.4.0",
    "pg": "^8.15.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14"
  }
}
