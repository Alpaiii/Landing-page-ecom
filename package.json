{
  "name": "roquace",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"cd server && npm run dev\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "astro build",
    "build:backend": "cd server && npm run build",
    "start": "cd server && npm start",
    "railway": "npm run build && cd server && npm run migrate && npm run seed && npm start",
    "migrate": "cd server && npm run migrate",
    "seed": "cd server && npm run seed"
  },
  "dependencies": {
    "@astrojs/tailwind": "@6.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "astro": "^5.7.10",
    "lucide": "^0.469.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
