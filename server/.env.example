# Railway PostgreSQL Configuration
# Auto-injected by Railway when you add PostgreSQL service
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Server Configuration
PORT=8000
NODE_ENV=production

# JWT Secret for Admin & Customer Auth
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin (Frontend URL)
# For production, use your Railway frontend URL
CORS_ORIGIN=https://roquace.up.railway.app

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/app/uploads

# Optional: Cloud Storage (recommended for production)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: Email Service
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional: Payment Gateway (Midtrans)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
