---
interface Tab {
  id: string;
  label: string;
  content: string | string[];
}

interface Props {
  description: string;
  material?: string;
  care?: string[];
  fit?: string;
}

const { description, material, care, fit } = Astro.props;

const tabs: Tab[] = [
  {
    id: 'description',
    label: 'Description',
    content: description,
  },
  {
    id: 'details',
    label: 'Details',
    content: material ? `Material: ${material}` : 'Material information not available',
  },
  {
    id: 'care',
    label: 'Care Instructions',
    content: care || ['Care instructions not available'],
  },
  {
    id: 'shipping',
    label: 'Shipping & Returns',
    content: [
      'Free shipping on orders over Rp500K',
      'Standard delivery: 3-5 business days',
      'Express delivery: 1-2 business days',
      'Easy returns within 7 days',
      'Items must be unworn and in original condition',
    ],
  },
];
---

<div class="product-tabs">
  <!-- Tab Navigation -->
  <div class="flex border-b border-border overflow-x-auto">
    {tabs.map((tab, index) => (
      <button
        class={`tab-button px-6 py-4 text-sm tracking-wider uppercase font-body whitespace-nowrap transition-colors ${
          index === 0 ? 'border-b-2 border-foreground text-foreground' : 'text-foreground/60 hover:text-foreground'
        }`}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <!-- Tab Content -->
  <div class="tab-content-container py-8">
    {tabs.map((tab, index) => (
      <div
        class={`tab-content ${index === 0 ? '' : 'hidden'}`}
        data-tab-content={tab.id}
      >
        {Array.isArray(tab.content) ? (
          <ul class="space-y-2">
            {tab.content.map((item) => (
              <li class="flex items-start gap-2 text-foreground/70 font-body leading-relaxed">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-foreground/70 font-body leading-relaxed">{tab.content}</p>
        )}
        
        {tab.id === 'details' && fit && (
          <p class="text-foreground/70 font-body leading-relaxed mt-4">
            <strong>Fit:</strong> {fit}
          </p>
        )}
      </div>
    ))}
  </div>
</div>

<script>
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetTab = (button as HTMLElement).dataset.tab;

      // Update buttons
      tabButtons.forEach((btn) => {
        btn.classList.remove('border-b-2', 'border-foreground', 'text-foreground');
        btn.classList.add('text-foreground/60');
      });
      button.classList.add('border-b-2', 'border-foreground', 'text-foreground');
      button.classList.remove('text-foreground/60');

      // Update content
      tabContents.forEach((content) => {
        content.classList.add('hidden');
      });
      const targetContent = document.querySelector(`[data-tab-content="${targetTab}"]`);
      targetContent?.classList.remove('hidden');
    });
  });
</script>
