---
import { siteConfig } from '../config/site';
import { mainNavLinks } from '../data/navigation';
import SearchOverlay from './SearchOverlay.astro';
import CartDrawer from './CartDrawer.astro';
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a href="/" class="font-heading text-3xl md:text-4xl tracking-wider relative z-10">
        {siteConfig.name}
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8 lg:gap-10">
        {mainNavLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm tracking-[0.15em] uppercase text-foreground/70 hover:text-foreground transition-colors duration-300 font-body"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Desktop Icons -->
      <div class="hidden md:flex items-center gap-4">
        <!-- Search Button -->
        <button
          id="search-btn"
          class="p-2 text-foreground/70 hover:text-foreground transition-colors duration-300"
          aria-label="Search"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Account (placeholder) -->
        <a
          href="/account"
          id="account-link"
          class="p-2 text-foreground/70 hover:text-foreground transition-colors duration-300"
          aria-label="Account"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>

        <!-- Wishlist -->
        <button
          id="wishlist-btn"
          class="p-2 text-foreground/70 hover:text-foreground transition-colors duration-300 relative"
          aria-label="Wishlist"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <!-- The badge is decorative; the count is conveyed by the button's label. -->
        <span id="wishlist-count" class="absolute -top-1 -right-1 w-4 h-4 bg-accent text-white text-xs rounded-full flex items-center justify-center hidden" aria-hidden="true">0</span>
        </button>

        <!-- Cart Button -->
        <button
          id="cart-btn"
          class="p-2 text-foreground/70 hover:text-foreground transition-colors duration-300 relative"
          aria-label="Cart"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span id="cart-count" class="absolute -top-1 -right-1 w-4 h-4 bg-accent text-white text-xs rounded-full flex items-center justify-center hidden" aria-hidden="true">0</span>
        </button>
      </div>

      <!-- Mobile Right Side -->
      <div class="flex md:hidden items-center gap-2">
        <!-- Cart Icon Mobile -->
        <button
          id="cart-btn-mobile"
          class="p-2 text-foreground/70 hover:text-foreground transition-colors duration-300 relative"
          aria-label="Cart"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span id="cart-count-mobile" class="absolute -top-1 -right-1 w-4 h-4 bg-accent text-white text-xs rounded-full flex items-center justify-center hidden" aria-hidden="true">0</span>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="p-2"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-close" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" class="hidden" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-8 border-t border-foreground/10 mt-2">
      <div class="flex flex-col gap-4 pt-6">
        {mainNavLinks.map((link) => (
          <a
            href={link.href}
            class="text-body tracking-[0.15em] uppercase text-foreground/70 hover:text-foreground transition-colors duration-300 py-2"
          >
            {link.label}
          </a>
        ))}
        <!-- Mobile Search -->
        <button
          id="search-btn-mobile"
          class="flex items-center gap-3 text-body tracking-[0.15em] uppercase text-foreground/70 hover:text-foreground transition-colors duration-300 py-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Search
        </button>
      </div>
    </div>
  </nav>
  
  <!-- Screen reader announcements -->
  <div aria-live="polite" aria-atomic="true" class="sr-only" id="cart-status-live"></div>
  <div aria-live="polite" aria-atomic="true" class="sr-only" id="wishlist-status-live"></div>
</header>

<SearchOverlay />
<CartDrawer />

<script>
  const navbar = document.getElementById('navbar');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');
  const searchBtn = document.getElementById('search-btn');
  const searchBtnMobile = document.getElementById('search-btn-mobile');
  const cartBtn = document.getElementById('cart-btn');
  const cartBtnMobile = document.getElementById('cart-btn-mobile');
  const cartCount = document.getElementById('cart-count');
  const cartCountMobile = document.getElementById('cart-count-mobile');
  const wishlistBtn = document.getElementById('wishlist-btn');
  const wishlistCount = document.getElementById('wishlist-count');

  // Transparent navbar on hero, solid when scrolling
  function updateNavbarStyle() {
    const currentScroll = window.scrollY;
    const heroHeight = window.innerHeight * 0.8; // Approximate hero height

    if (currentScroll < 100) {
      // On hero - transparent
      navbar?.classList.remove('bg-background/95', 'backdrop-blur-md', 'shadow-sm');
      navbar?.classList.add('bg-transparent');
    } else {
      // Scrolled - solid background
      navbar?.classList.remove('bg-transparent');
      navbar?.classList.add('bg-background/95', 'backdrop-blur-md');
      
      if (currentScroll > 200) {
        navbar?.classList.add('shadow-sm');
      } else {
        navbar?.classList.remove('shadow-sm');
      }
    }
  }

  // Initial call
  updateNavbarStyle();
  
  // Scroll listener
  window.addEventListener('scroll', updateNavbarStyle, { passive: true });

  // Mobile menu toggle
  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuOpen?.classList.toggle('hidden', isOpen);
    menuClose?.classList.toggle('hidden', !isOpen);
  });

  // Search overlay - use global function from SearchOverlay component
  searchBtn?.addEventListener('click', () => {
    if (typeof (window as any).openSearch === 'function') {
      (window as any).openSearch();
    }
  });

  searchBtnMobile?.addEventListener('click', () => {
    if (typeof (window as any).openSearch === 'function') {
      (window as any).openSearch();
    }
  });

  // Wishlist button - navigate to wishlist page
  wishlistBtn?.addEventListener('click', () => {
    window.location.href = '/wishlist';
  });

  // Update cart count from localStorage
  function updateCartCount() {
    try {
      const cart = JSON.parse(localStorage.getItem('roquace_cart') || '[]');
      const count = cart.reduce((sum: number, item: { quantity: number }) => sum + item.quantity, 0);
      const label = count > 99 ? '99+' : String(count);

      if (count > 0) {
        cartCount?.classList.remove('hidden');
        cartCountMobile?.classList.remove('hidden');
        if (cartCount) cartCount.textContent = label;
        if (cartCountMobile) cartCountMobile.textContent = label;
      } else {
        cartCount?.classList.add('hidden');
        cartCountMobile?.classList.add('hidden');
      }

      // The badge itself is aria-hidden, so the count has to be in the label.
      const cartBtn = document.getElementById('cart-btn');
      if (cartBtn) {
        cartBtn.setAttribute('aria-label', count > 0 ? `Cart, ${count} item${count !== 1 ? 's' : ''}` : 'Cart, empty');
      }
      
      // Announce to screen readers
      const liveRegion = document.getElementById('cart-status-live');
      if (liveRegion && count > 0) {
        liveRegion.textContent = `Cart updated. ${count} item${count !== 1 ? 's' : ''} in cart.`;
        setTimeout(() => { liveRegion.textContent = ''; }, 1000);
      }
    } catch {
      // Ignore errors
    }
  }

  // Update wishlist count from localStorage
  function updateWishlistCount() {
    try {
      const wishlist = JSON.parse(localStorage.getItem('roquace-wishlist') || '[]');
      const count = wishlist.length;

      if (count > 0) {
        wishlistCount?.classList.remove('hidden');
        if (wishlistCount) wishlistCount.textContent = count > 99 ? '99+' : String(count);
      } else {
        wishlistCount?.classList.add('hidden');
      }

      const wishlistBtn = document.getElementById('wishlist-btn');
      if (wishlistBtn) {
        wishlistBtn.setAttribute(
          'aria-label',
          count > 0 ? `Wishlist, ${count} item${count !== 1 ? 's' : ''}` : 'Wishlist, empty'
        );
      }
      
      // Announce to screen readers
      const liveRegion = document.getElementById('wishlist-status-live');
      if (liveRegion && count > 0) {
        liveRegion.textContent = `Wishlist updated. ${count} item${count !== 1 ? 's' : ''} saved.`;
        setTimeout(() => { liveRegion.textContent = ''; }, 1000);
      }
    } catch {
      // Ignore errors
    }
  }

  // Update on load and storage changes
  updateCartCount();
  updateWishlistCount();
  updateAccountLink();
  window.addEventListener('storage', () => {
    updateCartCount();
    updateWishlistCount();
    updateAccountLink();
  });
  
  // Custom events for updates
  window.addEventListener('cart-updated', updateCartCount);
  window.addEventListener('wishlist-updated', updateWishlistCount);

  // Update account link based on login status
  function updateAccountLink() {
    const accountLink = document.getElementById('account-link');
    if (!accountLink) return;

    try {
      const session = JSON.parse(localStorage.getItem('roquace_session') || '{}');
      if (session.loggedIn) {
        accountLink.href = '/account';
      } else {
        accountLink.href = '/login';
      }
    } catch (e) {
      accountLink.href = '/login';
    }
  }
</script>
