---
import { siteConfig } from '../config/site';

const navLinks = [
  { href: '/shop', label: 'Shop' },
  { href: '/#collections', label: 'Collection' },
  { href: '/about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-md transition-all duration-500">
  <nav class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a href="/" class="font-heading text-3xl md:text-4xl tracking-wider">
        {siteConfig.name}
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-10">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-body tracking-[0.15em] uppercase text-foreground/70 hover:text-foreground transition-colors duration-300"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Desktop CTA -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/shop" class="btn-primary py-3 px-8">
          Shop Now
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 -mr-2"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-close" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" class="hidden" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-8">
      <div class="flex flex-col gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-body tracking-[0.15em] uppercase text-foreground/70 hover:text-foreground transition-colors duration-300 py-2"
          >
            {link.label}
          </a>
        ))}
        <a href="/shop" class="btn-primary py-4 px-8 mt-2 text-center">
          Shop Now
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');

  // Scroll effect with smooth transition
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    
    if (currentScroll > 100) {
      navbar?.classList.add('shadow-sm', 'bg-background/98');
    } else {
      navbar?.classList.remove('shadow-sm', 'bg-background/98');
    }
    
    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuOpen?.classList.toggle('hidden', isOpen);
    menuClose?.classList.toggle('hidden', !isOpen);
  });
</script>
