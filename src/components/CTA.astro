---
---

<section id="contact" class="section-padding-lg bg-foreground text-background relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent rounded-full blur-3xl"></div>
  </div>
  
  <div class="relative container-custom text-center">
    <h2 class="heading-display text-background mb-8 md:mb-10">
      Find Your<br />Next Favorite.
    </h2>
    <p class="text-body-lg text-background/50 font-body max-w-2xl mx-auto mb-12 md:mb-14">
      Explore our latest collection and discover pieces that speak to your style.
    </p>
    <div class="flex flex-col sm:flex-row gap-5 md:gap-6 justify-center">
      <a href="/shop" class="btn-accent">
        Shop Now
      </a>
      <a
        href="https://wa.me/628123456789"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-10 py-5 border-2 border-background/30 text-background font-body font-medium transition-all duration-500 hover:bg-background hover:text-foreground hover:shadow-lg"
        style="font-size: clamp(0.875rem, 1.2vw, 1rem); letter-spacing: 0.15em; text-transform: uppercase;"
      >
        Chat via WhatsApp
      </a>
    </div>
  </div>
</section>
