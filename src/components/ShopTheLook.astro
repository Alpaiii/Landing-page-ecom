---
import { fetchProducts } from '../utils/productApi';

// Get featured products for the look
const products = await fetchProducts();
const lookProducts = products.filter((product) => product.featured).slice(0, 3);
const displayProducts = lookProducts.length > 0 ? lookProducts : products.slice(0, 3);
---

<section class="section-padding">
  <div class="container-custom">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="heading-lg mb-4">Shop The Look</h2>
      <p class="text-foreground/70 font-body">Complete your style with these pieces</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Large Fashion Image -->
      <div class="relative aspect-[3/4] bg-foreground/5">
        <img
          src="/images/products/tee.webp"
          alt="Shop the look styling"
          class="w-full h-full object-cover"
        />
        
        <!-- Product Hotspots -->
        <button
          class="hotspot absolute top-1/4 right-1/3 w-8 h-8 bg-white rounded-full shadow-lg flex items-center justify-center hover:scale-110 transition-transform cursor-pointer"
          data-product="0"
        >
          <span class="w-3 h-3 bg-foreground rounded-full animate-ping absolute"></span>
          <span class="w-3 h-3 bg-foreground rounded-full relative"></span>
        </button>

        <button
          class="hotspot absolute top-1/2 left-1/4 w-8 h-8 bg-white rounded-full shadow-lg flex items-center justify-center hover:scale-110 transition-transform cursor-pointer"
          data-product="1"
        >
          <span class="w-3 h-3 bg-foreground rounded-full animate-ping absolute"></span>
          <span class="w-3 h-3 bg-foreground rounded-full relative"></span>
        </button>

        <button
          class="hotspot absolute bottom-1/3 right-1/4 w-8 h-8 bg-white rounded-full shadow-lg flex items-center justify-center hover:scale-110 transition-transform cursor-pointer"
          data-product="2"
        >
          <span class="w-3 h-3 bg-foreground rounded-full animate-ping absolute"></span>
          <span class="w-3 h-3 bg-foreground rounded-full relative"></span>
        </button>
      </div>

      <!-- Product List -->
      <div class="flex flex-col justify-center space-y-6">
        {displayProducts.map((product, index) => (
          <div class="product-item flex gap-4 p-4 border border-transparent hover:border-border transition-colors" data-index={index}>
            <a href={`/products/${product.slug}`} class="w-24 h-28 flex-shrink-0 bg-foreground/5">
              <img
                src={product.thumbnail}
                alt={product.name}
                class="w-full h-full object-cover"
              />
            </a>
            <div class="flex-1 flex flex-col justify-center">
              <a href={`/products/${product.slug}`} class="font-body hover:text-accent transition-colors mb-2">
                {product.name}
              </a>
              <p class="text-sm text-foreground/60 font-body mb-2">
                {new Intl.NumberFormat('id-ID', {
                  style: 'currency',
                  currency: 'IDR',
                  minimumFractionDigits: 0,
                }).format(product.price)}
              </p>
              <a
                href={`/products/${product.slug}`}
                class="text-sm font-body underline hover:no-underline"
              >
                View Product →
              </a>
            </div>
          </div>
        ))}

        <!-- Shop The Look CTA -->
        <a
          href="/shop"
          class="mt-4 py-4 text-center border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
        >
          Shop The Look
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .animate-ping {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .hotspot:hover + .product-item,
  .product-item:hover {
    border-color: var(--color-foreground);
  }
</style>

<script>
  // Hotspot interactions
  document.querySelectorAll('.hotspot').forEach((hotspot) => {
    hotspot.addEventListener('click', () => {
      const productIndex = (hotspot as HTMLElement).dataset.product;
      const productItem = document.querySelector(`.product-item[data-index="${productIndex}"]`);
      
      if (productItem) {
        // Remove highlight from all
        document.querySelectorAll('.product-item').forEach(item => {
          item.classList.remove('border-foreground');
        });
        
        // Highlight selected
        productItem.classList.add('border-foreground');
        
        // Scroll to product
        productItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        
        // Remove highlight after 2 seconds
        setTimeout(() => {
          productItem.classList.remove('border-foreground');
        }, 2000);
      }
    });
  });
</script>
