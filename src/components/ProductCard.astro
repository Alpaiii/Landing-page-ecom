---
import type { Product } from '../data/products';
import { formatPrice, calculateDiscountPercentage } from '../utils/currency';

interface Props {
  product: Product;
  showQuickAdd?: boolean;
}

const { product, showQuickAdd = true } = Astro.props;

const discount = product.compareAtPrice ? calculateDiscountPercentage(product.compareAtPrice, product.price) : 0;
---

<div class="group">
  <!-- Product Image -->
  <a href={`/products/${product.slug}`} class="block relative aspect-[4/5] overflow-hidden mb-4">
    <img
      src={product.thumbnail}
      alt={product.name}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    
    <!-- Badge -->
    {product.badge && (
      <span class="absolute top-4 left-4 bg-foreground text-background text-xs px-4 py-2 tracking-wider uppercase font-body">
        {product.badge}
        {product.badge === 'Sale' && discount > 0 && ` -${discount}%`}
      </span>
    )}
    
    <!-- Sold Out Overlay -->
    {!product.inStock && (
      <div class="absolute inset-0 bg-background/80 flex items-center justify-center">
        <span class="text-sm tracking-wider uppercase font-body text-foreground/60">Sold Out</span>
      </div>
    )}
    
    <!-- Hover Actions -->
    <div class="absolute inset-x-0 bottom-0 p-4 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
      <div class="flex gap-2">
        <!-- Quick View Button -->
        <button
          class="quick-view-btn flex-1 bg-background/95 backdrop-blur-sm text-foreground py-3 text-xs tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
          data-product-id={product.id}
          aria-label={`Quick view ${product.name}`}
        >
          Quick View
        </button>
        
        <!-- Wishlist Button -->
        <button
          class="wishlist-btn w-12 h-12 bg-background/95 backdrop-blur-sm text-foreground flex items-center justify-center hover:bg-accent hover:text-white transition-colors"
          data-product-id={product.id}
          aria-label={`Add ${product.name} to wishlist`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </button>
      </div>
    </div>
  </a>
  
  <!-- Product Info -->
  <div>
    <!-- Color Options -->
    {product.colors.length > 0 && (
      <div class="flex gap-1.5 mb-3">
        {product.colors.slice(0, 4).map((color) => (
          <span
            class="w-4 h-4 rounded-full border border-foreground/10"
            style={`background-color: ${color.hex}`}
            title={color.name}
          />
        ))}
        {product.colors.length > 4 && (
          <span class="text-xs text-muted font-body">+{product.colors.length - 4}</span>
        )}
      </div>
    )}
    
    <!-- Name -->
    <h3 class="font-heading text-lg md:text-xl mb-1">
      <a href={`/products/${product.slug}`} class="hover:text-accent transition-colors duration-300">
        {product.name}
      </a>
    </h3>
    
    <!-- Rating -->
    {product.rating > 0 && (
      <div class="flex items-center gap-2 mb-2">
        <div class="flex items-center gap-0.5">
          {[...Array(5)].map((_, i) => (
            <svg
              class={`w-3.5 h-3.5 ${i < Math.floor(product.rating) ? 'text-accent' : 'text-foreground/20'}`}
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-xs text-muted font-body">({product.reviewCount})</span>
      </div>
    )}
    
    <!-- Price -->
    <div class="flex items-center gap-2">
      <p class="text-base text-accent font-body font-medium">{formatPrice(product.price)}</p>
      {product.compareAtPrice && (
        <p class="text-sm text-muted font-body line-through">{formatPrice(product.compareAtPrice)}</p>
      )}
    </div>
  </div>
</div>

<script>
  // Wishlist button functionality
  document.querySelectorAll('.wishlist-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const productId = (btn as HTMLButtonElement).dataset.productId;
      
      // Toggle wishlist state
      const svg = btn.querySelector('svg');
      const isInWishlist = svg?.getAttribute('fill') === 'currentColor';
      
      if (isInWishlist) {
        svg?.setAttribute('fill', 'none');
        btn.classList.remove('text-accent');
      } else {
        svg?.setAttribute('fill', 'currentColor');
        btn.classList.add('text-accent');
      }
      
      // Dispatch event for cart/wishlist update
      window.dispatchEvent(new CustomEvent('wishlist-updated'));
    });
  });
</script>
