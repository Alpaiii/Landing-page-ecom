---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatPrice(price: number): string {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
  }).format(price);
}

const whatsappUrl = `https://wa.me/628123456789?text=${encodeURIComponent(`Halo, saya tertarik dengan:\n${product.name}\nHarga: ${formatPrice(product.price)}\n\nApakah produk ini masih tersedia?`)}`;
---

<div class="group">
  <a href={`/products/${product.slug}`} class="block relative aspect-[4/5] overflow-hidden mb-5">
    <img
      src={product.image}
      alt={product.name}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    {product.badge && (
      <span class="absolute top-5 left-5 bg-foreground text-background text-sm px-5 py-2 tracking-wider uppercase font-body">
        {product.badge}
      </span>
    )}
  </a>
  <div>
    <h3 class="font-heading text-xl md:text-2xl mb-2">
      <a href={`/products/${product.slug}`} class="hover:text-accent transition-colors duration-300">
        {product.name}
      </a>
    </h3>
    <p class="text-body text-muted font-body mb-2">{product.category}</p>
    <p class="text-body text-accent font-body font-medium">{formatPrice(product.price)}</p>
  </div>
</div>
