---
/**
 * Generic page-level skeleton shown while a route's data is being resolved.
 * Used by the product detail, cart and checkout shells.
 */
interface Props {
  variant?: 'detail' | 'cart';
}

const { variant = 'detail' } = Astro.props;
---

<div aria-hidden="true">
  {variant === 'detail' ? (
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
      <!-- Gallery -->
      <div>
        <div class="animate-pulse aspect-[4/5] bg-foreground/10"></div>
        <div class="flex gap-3 mt-4">
          {[...Array(4)].map(() => (
            <div class="animate-pulse w-20 h-24 bg-foreground/10"></div>
          ))}
        </div>
      </div>

      <!-- Info -->
      <div class="space-y-6 pt-4">
        <div class="animate-pulse h-3 bg-foreground/10 w-24"></div>
        <div class="animate-pulse h-10 bg-foreground/10 w-3/4"></div>
        <div class="animate-pulse h-4 bg-foreground/10 w-40"></div>
        <div class="animate-pulse h-6 bg-foreground/10 w-32"></div>

        <div class="space-y-3 pt-4">
          <div class="animate-pulse h-3 bg-foreground/10 w-16"></div>
          <div class="flex gap-3">
            {[...Array(4)].map(() => (
              <div class="animate-pulse w-9 h-9 rounded-full bg-foreground/10"></div>
            ))}
          </div>
        </div>

        <div class="space-y-3">
          <div class="animate-pulse h-3 bg-foreground/10 w-16"></div>
          <div class="flex gap-2">
            {[...Array(5)].map(() => (
              <div class="animate-pulse w-12 h-11 border border-border"></div>
            ))}
          </div>
        </div>

        <div class="space-y-3 pt-4">
          <div class="animate-pulse h-14 w-full bg-foreground/10"></div>
          <div class="animate-pulse h-14 w-full bg-foreground/10"></div>
        </div>
      </div>
    </div>
  ) : (
    <div class="grid lg:grid-cols-3 gap-12 lg:gap-16">
      <div class="lg:col-span-2 space-y-4">
        {[...Array(3)].map(() => (
          <div class="animate-pulse flex gap-4 py-4 border-b border-border">
            <div class="w-24 h-32 bg-foreground/10 flex-shrink-0"></div>
            <div class="flex-1 space-y-3 py-2">
              <div class="h-3 bg-foreground/10 w-1/3"></div>
              <div class="h-4 bg-foreground/10 w-2/3"></div>
              <div class="h-4 bg-foreground/10 w-24"></div>
            </div>
          </div>
        ))}
      </div>

      <div class="space-y-4">
        <div class="animate-pulse h-4 bg-foreground/10 w-1/2"></div>
        <div class="animate-pulse h-4 bg-foreground/10 w-full"></div>
        <div class="animate-pulse h-4 bg-foreground/10 w-2/3"></div>
        <div class="animate-pulse h-14 w-full bg-foreground/10 mt-6"></div>
      </div>
    </div>
  )}
</div>

<style>
  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse {
    animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
