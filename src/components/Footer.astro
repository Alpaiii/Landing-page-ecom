---
import { siteConfig } from '../config/site';

const shopLinks = [
  { href: '/shop', label: 'All Products' },
  { href: '/shop?filter=new-arrival', label: 'New Arrivals' },
  { href: '/shop?filter=best-seller', label: 'Best Sellers' },
  { href: '/shop?filter=sale', label: 'Sale' },
];

const infoLinks = [
  { href: '/about', label: 'Our Story' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];

const socialLinks = [
  { href: `https://instagram.com/${siteConfig.instagram.replace('@', '')}`, label: 'Instagram' },
  { href: `https://tiktok.com/${siteConfig.tiktok.replace('@', '')}`, label: 'TikTok' },
  { href: `https://wa.me/${siteConfig.whatsapp}`, label: 'WhatsApp' },
];
---

<footer class="bg-foreground text-background relative overflow-hidden">
  <!-- Decorative Background -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-0 left-0 w-96 h-96 bg-accent rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
  </div>

  <!-- Newsletter Section -->
  <div class="relative border-b border-background/10">
    <div class="container-custom py-16 md:py-20">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h3 class="heading-md text-background mb-3">Stay in the Loop</h3>
          <p class="text-background/60 text-body">Get notified about new drops, exclusive offers, and style inspiration.</p>
        </div>
        <div class="flex gap-3">
          <input
            type="email"
            placeholder="Your email address"
            class="flex-1 px-6 py-4 bg-background/10 border border-background/20 text-background placeholder:text-background/40 font-body focus:outline-none focus:border-accent transition-colors"
          />
          <button class="btn-accent px-8 py-4">
            Subscribe
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="relative">
    <div class="container-custom py-16 md:py-20">
      <div class="grid grid-cols-2 md:grid-cols-12 gap-10 md:gap-8">
        <!-- Brand -->
        <div class="col-span-2 md:col-span-4">
          <a href="/" class="font-heading text-3xl md:text-4xl tracking-wider inline-block mb-5">
            {siteConfig.name}
          </a>
          <p class="text-background/50 text-body leading-relaxed mb-6 max-w-xs">
            {siteConfig.description}
          </p>
          <div class="flex gap-4">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 border border-background/20 flex items-center justify-center text-background/60 hover:bg-accent hover:border-accent hover:text-white transition-all duration-300"
                aria-label={link.label}
              >
                {link.label === 'Instagram' && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                )}
                {link.label === 'TikTok' && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 10.86 4.43v-7.15a8.16 8.16 0 0 0 5.58 2.18v-3.45a4.85 4.85 0 0 1-2-.67z"/></svg>
                )}
                {link.label === 'WhatsApp' && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                )}
              </a>
            ))}
          </div>
        </div>

        <!-- Shop -->
        <div class="col-span-1 md:col-span-2 md:col-start-6">
          <h4 class="font-body font-semibold text-sm tracking-[0.2em] uppercase mb-6 text-background">Shop</h4>
          <ul class="space-y-4">
            {shopLinks.map((link) => (
              <li>
                <a href={link.href} class="text-background/50 hover:text-accent transition-colors duration-300 text-body">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- About -->
        <div class="col-span-1 md:col-span-2">
          <h4 class="font-body font-semibold text-sm tracking-[0.2em] uppercase mb-6 text-background">About</h4>
          <ul class="space-y-4">
            {infoLinks.map((link) => (
              <li>
                <a href={link.href} class="text-background/50 hover:text-accent transition-colors duration-300 text-body">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div class="col-span-2 md:col-span-3">
          <h4 class="font-body font-semibold text-sm tracking-[0.2em] uppercase mb-6 text-background">Contact</h4>
          <ul class="space-y-4">
            <li>
              <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-background/50 hover:text-accent transition-colors duration-300 text-body flex items-center gap-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                WhatsApp
              </a>
            </li>
            <li>
              <a href={`mailto:hello@${siteConfig.name.toLowerCase()}.com`} class="text-background/50 hover:text-accent transition-colors duration-300 text-body flex items-center gap-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                Email
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-background/10">
      <div class="container-custom py-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-background/30 text-sm font-body">
          © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
        </p>
        <div class="flex gap-6">
          <a href="/privacy" class="text-background/30 hover:text-background/60 text-sm font-body transition-colors">Privacy Policy</a>
          <a href="/terms" class="text-background/30 hover:text-background/60 text-sm font-body transition-colors">Terms of Service</a>
        </div>
      </div>
    </div>
  </div>
</footer>
