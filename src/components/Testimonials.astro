---
import { testimonials } from '../data/testimonials';
---

<section class="section-padding bg-background">
  <div class="container-custom max-w-5xl">
    <div class="text-center mb-16 md:mb-20">
      <p class="text-body tracking-[0.3em] uppercase text-muted mb-6 font-body">What They're Wearing</p>
      <h2 class="heading-lg">Customer Stories</h2>
    </div>
    <div class="space-y-20">
      {testimonials.map((testimonial) => (
        <div class="text-center">
          <div class="flex justify-center gap-1.5 mb-8">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="heading-md font-heading font-light leading-relaxed mb-8 max-w-3xl mx-auto">
            "{testimonial.text}"
          </blockquote>
          <div>
            <p class="font-body font-semibold text-body">— {testimonial.name}</p>
            <p class="text-body text-muted font-body">Verified Customer</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
