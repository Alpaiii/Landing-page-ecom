---
import { testimonials } from '../data/testimonials';
---

<section class="section-padding bg-background">
  <div class="container-custom max-w-6xl">
    <div class="text-center mb-16 md:mb-20">
      <p class="text-body tracking-[0.3em] uppercase text-muted mb-6 font-body">What They're Wearing</p>
      <h2 class="heading-lg mb-5">Customer Stories</h2>
      <div class="editorial-divider mx-auto"></div>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((testimonial) => (
        <figure class="flex flex-col bg-white border border-border p-8 md:p-10 transition-all duration-500 ease-out hover:border-accent/40 hover:shadow-xl hover:shadow-foreground/5">
          <svg class="w-10 h-10 text-accent/30 mb-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <div class="flex gap-1.5 mb-6">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="font-body text-body-lg leading-relaxed text-foreground mb-8 flex-1">
            "{testimonial.text}"
          </blockquote>
          <figcaption class="border-t border-border pt-6">
            <p class="font-body font-semibold text-body">{testimonial.name}</p>
            {testimonial.product && (
              <p class="text-body text-muted font-body font-light">{testimonial.product}</p>
            )}
            <p class="text-sm text-accent font-body font-medium mt-2 inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Verified Purchase
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>