---
// Trust badges section
const trustFeatures = [
  {
    icon: 'truck',
    title: 'Free Shipping',
    description: 'On orders over Rp500K',
  },
  {
    icon: 'return',
    title: 'Easy Returns',
    description: '7-day return policy',
  },
  {
    icon: 'secure',
    title: 'Secure Payment',
    description: 'Safe & secure checkout',
  },
  {
    icon: 'support',
    title: 'Customer Support',
    description: 'WhatsApp support available',
  },
];
---

<section class="section-padding border-y border-border">
  <div class="container-custom">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      {trustFeatures.map((feature) => (
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center">
            {feature.icon === 'truck' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
              </svg>
            )}
            {feature.icon === 'return' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
              </svg>
            )}
            {feature.icon === 'secure' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {feature.icon === 'support' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            )}
          </div>
          <h3 class="text-sm tracking-wider uppercase font-body mb-2">{feature.title}</h3>
          <p class="text-sm text-foreground/60 font-body">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
