---
import { siteConfig } from '../config/site';
---

<section class="py-12 md:py-16 border-b border-foreground/10">
  <div class="container-custom">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <!-- Customers -->
      <div class="text-center">
        <p class="heading-md text-accent mb-2">{siteConfig.metrics.customers}</p>
        <p class="text-sm tracking-wider uppercase text-muted font-body">{siteConfig.metrics.customersLabel}</p>
      </div>
      
      <!-- Rating -->
      <div class="text-center">
        <p class="heading-md text-accent mb-2">{siteConfig.metrics.rating}</p>
        <p class="text-sm tracking-wider uppercase text-muted font-body">{siteConfig.metrics.ratingLabel}</p>
      </div>
      
      <!-- Products -->
      <div class="text-center">
        <p class="heading-md text-accent mb-2">{siteConfig.metrics.products}</p>
        <p class="text-sm tracking-wider uppercase text-muted font-body">{siteConfig.metrics.productsLabel}</p>
      </div>
      
      <!-- Shipping -->
      <div class="text-center">
        <p class="heading-md text-accent mb-2">{siteConfig.metrics.shipping}</p>
        <p class="text-sm tracking-wider uppercase text-muted font-body">{siteConfig.metrics.shippingLabel}</p>
      </div>
    </div>
  </div>
</section>
