---
---

<section class="section-padding">
  <div class="container-custom">
    <div class="text-center mb-12 md:mb-16">
      <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">Lookbook</p>
      <h2 class="heading-lg">Style in Focus</h2>
      <p class="text-foreground/60 font-body mt-4">2026 / Autumn Collection</p>
    </div>
    <div class="grid md:grid-cols-12 gap-4 md:gap-6">
      <div class="md:col-span-8 aspect-[3/4] overflow-hidden">
        <img
          src="/images/lookbook/lookbook-1.jpg"
          alt="Lookbook 1"
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
      </div>
      <div class="md:col-span-4 grid grid-rows-2 gap-4 md:gap-6">
        <div class="aspect-square overflow-hidden">
          <img
            src="/images/lookbook/lookbook-2.jpg"
            alt="Lookbook 2"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <div class="aspect-square overflow-hidden">
          <img
            src="/images/lookbook/lookbook-3.jpg"
            alt="Lookbook 3"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
