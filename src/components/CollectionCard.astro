---
interface Props {
  name: string;
  description: string;
  image: string;
  slug: string;
  featured?: boolean;
}

const { name, description, image, slug, featured = false } = Astro.props;
---

<a href={`/shop/${slug}`} class={`group relative block overflow-hidden ${featured ? 'aspect-[3/4] md:aspect-[4/5]' : 'aspect-[3/4]'}`}>
  <img
    src={image}
    alt={name}
    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
  <div class={`absolute bottom-0 left-0 right-0 p-8 md:p-12 ${featured ? 'md:p-14' : ''}`}>
    <h3 class={`font-heading text-white mb-3 ${featured ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl'}`}>{name}</h3>
    <p class={`text-white/70 font-body mb-6 ${featured ? 'text-body-lg max-w-md' : 'text-body'}`}>{description}</p>
    <span class="inline-flex items-center text-body tracking-wider uppercase font-body text-white group-hover:text-accent-light transition-colors duration-300">
      Explore Collection
      <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  </div>
</a>
