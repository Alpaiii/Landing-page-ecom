---
interface Props {
  message?: string;
  showActions?: boolean;
}

const { 
  message = "Unable to load product. This item may no longer be available.",
  showActions = true 
} = Astro.props;
---

<div class="product-error p-8 border border-border bg-foreground/5 text-center">
  <div class="mb-4">
    <svg class="w-16 h-16 mx-auto text-foreground/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </div>
  <h3 class="text-lg font-body font-medium mb-2">Product Unavailable</h3>
  <p class="text-sm font-body text-foreground/70 mb-6 max-w-md mx-auto">{message}</p>
  {showActions && (
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/shop"
        class="inline-block px-6 py-3 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
      >
        Browse Shop
      </a>
      <button
        onclick="window.history.back()"
        class="inline-block px-6 py-3 border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
      >
        Go Back
      </button>
    </div>
  )}
</div>
