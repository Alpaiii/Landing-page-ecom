---
---

<section class="section-padding bg-background">
  <div class="container-custom">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="md:col-span-7 aspect-[4/5] overflow-hidden">
        <img
          src="/images/brand-story.jpg"
          alt="Our Story"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="md:col-span-5 flex flex-col justify-center">
        <p class="text-body tracking-[0.3em] uppercase text-muted mb-6 font-body">Our Story</p>
        <h2 class="heading-lg mb-8">
          Crafted with<br />purpose.
        </h2>
        <div class="mb-10">
          <p class="text-body-lg text-foreground/70 font-heading italic leading-relaxed">
            "We believe fashion isn't simply what you wear, but how you express yourself."
          </p>
        </div>
        <div class="space-y-5 text-body text-foreground/50 font-body">
          <p>
            Born from a passion for contemporary fashion, roquace represents the modern individual 
            who values both style and substance.
          </p>
          <p>
            Every piece is thoughtfully designed to seamlessly blend into your everyday life, 
            offering comfort without compromising on style.
          </p>
        </div>
        <a href="/about" class="inline-flex items-center text-body tracking-wider uppercase font-body mt-10 hover:text-accent transition-colors duration-300 group">
          Read Our Story
          <svg class="w-5 h-5 ml-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
