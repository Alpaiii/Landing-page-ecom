---
interface Props {
  productId: string;
}

const { productId } = Astro.props;

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';

// Fetch reviews from API
let reviews: any[] = [];
let stats = {
  total: 0,
  average: 0,
  breakdown: [
    { rating: 5, count: 0, percentage: 0 },
    { rating: 4, count: 0, percentage: 0 },
    { rating: 3, count: 0, percentage: 0 },
    { rating: 2, count: 0, percentage: 0 },
    { rating: 1, count: 0, percentage: 0 }
  ]
};

try {
  const response = await fetch(`${API_URL}/api/reviews/product/${productId}?limit=3`);
  if (response.ok) {
    const result = await response.json();
    reviews = result.data || [];
    stats = result.stats || stats;
  }
} catch (error) {
  console.error('Failed to fetch reviews:', error);
}
---

<section class="section-padding pt-0" aria-labelledby="reviews-heading">
  <div class="container-custom">
    <div class="border-t border-border pt-16 md:pt-24">
      <h2 id="reviews-heading" class="text-2xl md:text-3xl font-heading mb-10">Customer Reviews</h2>

      <div class="grid lg:grid-cols-3 gap-10 lg:gap-16">
        <!-- Rating Summary -->
        <div class="lg:col-span-1">
          <div class="flex items-baseline gap-3 mb-2">
            <span class="text-5xl font-heading">{stats.average.toFixed(1)}</span>
            <span class="text-sm text-foreground/60 font-body">out of 5</span>
          </div>

          <div class="flex items-center gap-1 mb-1" aria-hidden="true">
            {[...Array(5)].map((_, i) => (
              <svg
                class={`w-4 h-4 ${i < Math.floor(stats.average) ? 'text-accent' : 'text-foreground/20'}`}
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <p class="text-sm text-foreground/60 font-body mb-8">
            Based on {stats.total} review{stats.total !== 1 ? 's' : ''}
          </p>

          <!-- Distribution Bars -->
          <div class="space-y-2.5">
            {stats.breakdown.map((row) => (
              <div class="flex items-center gap-3">
                <span class="text-xs font-body text-foreground/60 w-3 shrink-0">{row.rating}</span>
                <svg class="w-3.5 h-3.5 shrink-0 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <div class="flex-1 h-1.5 bg-foreground/10 overflow-hidden">
                  <div class="h-full bg-accent" style={`width: ${row.percentage}%`}></div>
                </div>
                <span class="text-xs font-body text-foreground/50 w-9 text-right shrink-0">{row.percentage}%</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Review List -->
        <div class="lg:col-span-2">
          {reviews.length > 0 ? (
            <>
              <ul class="divide-y divide-border">
                {reviews.map((review) => (
                  <li class="py-6 first:pt-0">
                    <div class="flex items-center gap-1 mb-3" aria-label={`${review.rating} out of 5 stars`}>
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < review.rating ? 'text-accent' : 'text-foreground/20'}`}
                          fill="currentColor"
                          viewBox="0 0 20 20"
                          aria-hidden="true"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>

                    <h3 class="font-body font-medium mb-2">{review.title}</h3>
                    <p class="text-foreground/70 font-body leading-relaxed mb-4">{review.comment}</p>

                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-body text-foreground/60">
                      <span class="text-foreground">{review.customer_name}</span>
                      {review.is_verified && (
                        <span class="inline-flex items-center gap-1 text-accent">
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5L3 10.5v5.5a1 1 0 001 1h2a1 1 0 001-1v-2h1v2a1 1 0 001 1h2a1 1 0 001-1v-5.5L10.5 5.5A4.5 4.5 0 0010 1zm3.707 4.793a1 1 0 00-1.414-1.414L9 7.586 7.707 6.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l3-3z" clip-rule="evenodd" />
                          </svg>
                          Verified Purchase
                        </span>
                      )}
                      <time datetime={review.created_at}>
                        {new Date(review.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                    </div>

                    <div class="mt-4" data-helpful-group>
                      <button
                        type="button"
                        class="helpful-btn inline-flex items-center gap-2 text-sm font-body text-foreground/60 hover:text-foreground transition-colors"
                        data-count={review.helpfulCount}
                        aria-pressed="false"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 9V5a3 3 0 00-3-3L7 11v11h11.28a2 2 0 002-1.72l1.38-9a2 2 0 00-2-2.28zM7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3" />
                        </svg>
                        Helpful (<span data-helpful-count>{review.helpfulCount}</span>)
                      </button>
                    </div>
                  </li>
                ))}
              </ul>

              {reviews.length > 3 && (
                <p class="text-sm text-foreground/60 font-body mt-6">
                  Showing 3 of {stats.total} written reviews.
                </p>
              )}
            </>
          ) : (
            <div class="text-center py-12 border border-border">
              <svg class="w-14 h-14 mx-auto mb-4 text-foreground/20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <p class="text-foreground/70 font-body mb-1">No written reviews yet</p>
              <p class="text-sm text-foreground/50 font-body">Be the first to share your experience.</p>
            </div>
          )}

        </div>
      </div>
    </div>

    <!-- Write a Review Form -->
    <div class="lg:col-span-2 mt-16">
      <h3 class="text-xl tracking-wider uppercase font-body mb-6">Write a Review</h3>
      <div id="review-form-section">
        <div id="login-prompt" class="hidden p-6 border border-border text-center">
          <p class="text-foreground/70 font-body mb-4">Please log in to write a review</p>
          <a href="/login?return=/products/{productId}" class="btn-secondary inline-block">Log In</a>
        </div>
        <form id="review-form" class="hidden space-y-6">
          <div>
            <label class="block text-sm tracking-wider uppercase font-body mb-3">Your Rating *</label>
            <div class="flex items-center gap-2" id="star-rating">
              {[...Array(5)].map((_, i) => (
                <button
                  type="button"
                  class="star-btn text-4xl text-foreground/20 hover:text-accent transition-colors"
                  data-rating={i + 1}
                  aria-label={`${i + 1} stars`}
                >
                  ☆
                </button>
              ))}
            </div>
            <input type="hidden" id="review-rating" name="rating" required />
            <p id="rating-error" class="text-xs text-red-500 mt-1 hidden"></p>
          </div>

          <div>
            <label for="review-title" class="block text-sm tracking-wider uppercase font-body mb-2">Review Title *</label>
            <input
              type="text"
              id="review-title"
              name="title"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="Summarize your experience"
            />
          </div>

          <div>
            <label for="review-comment" class="block text-sm tracking-wider uppercase font-body mb-2">Your Review *</label>
            <textarea
              id="review-comment"
              name="comment"
              required
              rows="4"
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="Share your experience with this product..."
            ></textarea>
          </div>

          <div id="review-message" class="hidden p-4 text-sm font-body"></div>

          <button
            type="submit"
            id="submit-review"
            class="py-3 px-8 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
          >
            Submit Review
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ productId }}>
  const API_URL = 'http://localhost:4000';

  // Star rating
  let selectedRating = 0;
  const starBtns = document.querySelectorAll<HTMLButtonElement>('.star-btn');
  const ratingInput = document.getElementById('review-rating') as HTMLInputElement;
  const ratingError = document.getElementById('rating-error');

  starBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectedRating = Number(btn.dataset.rating);
      ratingInput.value = String(selectedRating);
      ratingError?.classList.add('hidden');
      
      starBtns.forEach(b => {
        const r = Number(b.dataset.rating);
        b.textContent = r <= selectedRating ? '★' : '☆';
        b.classList.toggle('text-accent', r <= selectedRating);
        b.classList.toggle('text-foreground/20', r > selectedRating);
      });
    });
  });

  // Helpful votes
  const VOTED_KEY = 'roquace-helpful-votes';

  function getVoted(): string[] {
    try {
      return JSON.parse(localStorage.getItem(VOTED_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveVoted(votes: string[]): void {
    localStorage.setItem(VOTED_KEY, JSON.stringify(votes));
  }

  document.querySelectorAll<HTMLButtonElement>('.helpful-btn').forEach((button, index) => {
    const key = `review-${index}`;
    const countEl = button.querySelector('[data-helpful-count]');

    if (getVoted().includes(key)) {
      button.setAttribute('aria-pressed', 'true');
      button.classList.add('text-accent');
    }

    button.addEventListener('click', () => {
      if (button.getAttribute('aria-pressed') === 'true') return;

      const votes = getVoted();
      votes.push(key);
      saveVoted(votes);

      const base = Number(button.dataset.count || 0);
      if (countEl) countEl.textContent = String(base + 1);

      button.setAttribute('aria-pressed', 'true');
      button.classList.add('text-accent');
    });
  });

  // Review form
  const reviewForm = document.getElementById('review-form');
  const loginPrompt = document.getElementById('login-prompt');
  const reviewMessage = document.getElementById('review-message');
  const submitBtn = document.getElementById('submit-review');

  async function checkAuthAndShowForm() {
    const token = localStorage.getItem('customer_token');
    
    if (!token) {
      loginPrompt?.classList.remove('hidden');
      reviewForm?.classList.add('hidden');
      return false;
    }

    // Verify token
    try {
      const response = await fetch(`${API_URL}/api/customers/customer-verify`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!response.ok) {
        throw new Error('Invalid token');
      }

      loginPrompt?.classList.add('hidden');
      reviewForm?.classList.remove('hidden');
      return true;
    } catch (e) {
      localStorage.removeItem('customer_token');
      loginPrompt?.classList.remove('hidden');
      reviewForm?.classList.add('hidden');
      return false;
    }
  }

  function showReviewMessage(message: string, type: 'success' | 'error') {
    if (!reviewMessage) return;
    reviewMessage.textContent = message;
    reviewMessage.className = `p-4 text-sm font-body ${
      type === 'success' 
        ? 'bg-accent/10 border border-accent/20 text-accent' 
        : 'bg-red-500/10 border border-red-500/20 text-red-500'
    }`;
    reviewMessage.classList.remove('hidden');
  }

  reviewForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!selectedRating) {
      ratingError?.classList.remove('hidden');
      return;
    }

    const token = localStorage.getItem('customer_token');
    if (!token) return;

    const title = (document.getElementById('review-title') as HTMLInputElement).value;
    const comment = (document.getElementById('review-comment') as HTMLTextAreaElement).value;

    submitBtn?.setAttribute('disabled', 'true');
    submitBtn!.textContent = 'Submitting...';

    try {
      const response = await fetch(`${API_URL}/api/reviews`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          product_id: productId,
          rating: selectedRating,
          title,
          comment
        })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Failed to submit review');
      }

      showReviewMessage('✓ Thank you for your review!', 'success');
      reviewForm?.reset();
      selectedRating = 0;
      ratingInput.value = '';
      starBtns.forEach(b => {
        b.textContent = '☆';
        b.classList.remove('text-accent');
        b.classList.add('text-foreground/20');
      });

      setTimeout(() => {
        window.location.reload();
      }, 2000);
    } catch (error: any) {
      showReviewMessage(`✗ ${error.message || 'Failed to submit review'}`, 'error');
    } finally {
      submitBtn?.removeAttribute('disabled');
      submitBtn!.textContent = 'Submit Review';
    }
  });

  // Initialize
  checkAuthAndShowForm();
</script>