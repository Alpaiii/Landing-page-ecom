---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'Order Confirmed';
const description = 'Thank you for your purchase';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-3xl">
        <!-- Success Icon -->
        <div class="text-center mb-8">
          <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-10 h-10 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h1 class="text-3xl md:text-4xl font-heading mb-4">Order Confirmed!</h1>
          <p class="text-foreground/70 font-body mb-2">Thank you for your purchase</p>
          <p id="order-id" class="text-lg font-body font-medium"></p>
        </div>

        <!-- Order Details -->
        <div class="border border-border p-6 md:p-8 mb-8">
          <h2 class="text-xl tracking-wider uppercase font-body mb-6">Order Details</h2>

          <!-- Estimated Delivery -->
          <div class="mb-6 p-4 bg-foreground/5">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="text-sm font-body font-medium mb-1">Estimated Delivery</p>
                <p id="estimated-delivery" class="text-sm text-foreground/70 font-body"></p>
              </div>
            </div>
          </div>

          <!-- Order Items -->
          <div class="mb-6">
            <h3 class="text-sm tracking-wider uppercase font-body mb-4">Items</h3>
            <div id="order-items" class="space-y-4">
              <!-- Populated by JavaScript -->
            </div>
          </div>

          <!-- Order Summary -->
          <div class="space-y-3 pt-6 border-t border-border">
            <div class="flex items-center justify-between text-sm font-body">
              <span class="text-foreground/70">Subtotal</span>
              <span id="order-subtotal"></span>
            </div>
            <div class="flex items-center justify-between text-sm font-body">
              <span class="text-foreground/70">Shipping</span>
              <span id="order-shipping"></span>
            </div>
            <div class="flex items-center justify-between text-lg font-body pt-3 border-t border-border">
              <span class="font-medium">Total</span>
              <span id="order-total" class="font-medium"></span>
            </div>
          </div>

          <!-- Payment Method -->
          <div class="mt-6 pt-6 border-t border-border">
            <p class="text-sm text-foreground/70 font-body mb-1">Payment Method</p>
            <p id="payment-method" class="text-sm font-body font-medium capitalize"></p>
          </div>
        </div>

        <!-- What's Next -->
        <div class="border border-border p-6 md:p-8 mb-8">
          <h2 class="text-xl tracking-wider uppercase font-body mb-6">What's Next?</h2>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-foreground text-background flex items-center justify-center flex-shrink-0 text-sm font-body">1</div>
              <div>
                <p class="text-sm font-body font-medium mb-1">Order Confirmation Email</p>
                <p class="text-sm text-foreground/70 font-body">We've sent a confirmation email to your inbox with your order details.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-foreground text-background flex items-center justify-center flex-shrink-0 text-sm font-body">2</div>
              <div>
                <p class="text-sm font-body font-medium mb-1">Order Processing</p>
                <p class="text-sm text-foreground/70 font-body">We'll prepare your order for shipping within 1-2 business days.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-foreground text-background flex items-center justify-center flex-shrink-0 text-sm font-body">3</div>
              <div>
                <p class="text-sm font-body font-medium mb-1">Shipping Updates</p>
                <p class="text-sm text-foreground/70 font-body">You'll receive tracking information once your order ships.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/track-order"
            class="flex-1 py-4 bg-foreground text-background text-center text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
          >
            Track Order
          </a>
          <a
            href="/shop"
            class="flex-1 py-4 border border-border text-center text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
          >
            Continue Shopping
          </a>
        </div>

        <!-- Customer Support -->
        <div class="mt-12 text-center">
          <p class="text-sm text-foreground/70 font-body mb-4">Need help with your order?</p>
          <a href="/contact" class="text-sm font-body underline hover:no-underline">
            Contact Customer Support
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const API_URL = 'http://localhost:4000';

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(price);
  }

  function formatDate(daysFromNow: number): string {
    const date = new Date();
    date.setDate(date.getDate() + daysFromNow);
    return date.toLocaleDateString('en-US', { 
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    });
  }

  // Get order ID from URL
  const urlParams = new URLSearchParams(window.location.search);
  const orderId = urlParams.get('orderId');

  if (!orderId) {
    window.location.href = '/shop';
  }

  // Load order data from localStorage first (for immediate display)
  async function loadOrder() {
    try {
      const localOrder = JSON.parse(localStorage.getItem('roquace_last_order') || '{}');
      
      // Display order ID immediately
      const orderIdEl = document.getElementById('order-id');
      if (orderIdEl) {
        orderIdEl.textContent = `Order #${orderId?.substring(0, 8)}`;
      }

      // Try to fetch from API
      const response = await fetch(`${API_URL}/api/orders/${orderId}`);
      
      if (!response.ok) {
        throw new Error('Order not found');
      }

      const result = await response.json();
      const orderData = result.data;

      // Display estimated delivery
      const estimatedDeliveryEl = document.getElementById('estimated-delivery');
      if (estimatedDeliveryEl) {
        const days = orderData.shipping_method === 'express' ? 2 : orderData.shipping_method === 'same-day' ? 1 : 5;
        estimatedDeliveryEl.textContent = `${formatDate(days)}`;
      }

      // Display order items
      const orderItemsEl = document.getElementById('order-items');
      if (orderItemsEl && orderData.items) {
        orderItemsEl.innerHTML = orderData.items.map((item: any) => `
          <div class="flex gap-4">
            <div class="w-16 h-20 flex-shrink-0 bg-foreground/5">
              <img src="${item.image || '/images/placeholder.jpg'}" alt="${item.name}" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1">
              <p class="text-sm font-body mb-1">${item.name}</p>
              <p class="text-xs text-foreground/60 font-body">Quantity: ${item.quantity}</p>
              <p class="text-sm font-body font-medium mt-2">${formatPrice(item.price * item.quantity)}</p>
            </div>
          </div>
        `).join('');
      }

      // Display totals
      const orderSubtotalEl = document.getElementById('order-subtotal');
      const orderShippingEl = document.getElementById('order-shipping');
      const orderTotalEl = document.getElementById('order-total');

      if (orderSubtotalEl) orderSubtotalEl.textContent = formatPrice(orderData.subtotal);
      if (orderShippingEl) orderShippingEl.textContent = orderData.shipping_cost > 0 ? formatPrice(orderData.shipping_cost) : 'Free';
      if (orderTotalEl) orderTotalEl.textContent = formatPrice(orderData.total_amount);

      // Display payment method
      const paymentMethodEl = document.getElementById('payment-method');
      if (paymentMethodEl && orderData.payment_method) {
        const paymentNames: Record<string, string> = {
          'qris': 'QRIS',
          'bank_transfer': 'Bank Transfer',
          'ewallet': 'E-Wallet',
          'card': 'Credit/Debit Card',
          'cod': 'Cash on Delivery'
        };
        paymentMethodEl.textContent = paymentNames[orderData.payment_method] || orderData.payment_method;
      }

      // Clear localStorage
      localStorage.removeItem('roquace_last_order');
    } catch (error) {
      console.error('Load order error:', error);
      // Fallback to localStorage if API fails
      const localOrder = JSON.parse(localStorage.getItem('roquace_last_order') || '{}');
      if (localOrder.orderId) {
        // Display from localStorage
        const orderIdEl = document.getElementById('order-id');
        if (orderIdEl) orderIdEl.textContent = `Order #${localOrder.orderId}`;
        
        const orderTotalEl = document.getElementById('order-total');
        if (orderTotalEl) orderTotalEl.textContent = formatPrice(localOrder.total);
      } else {
        window.location.href = '/shop';
      }
    }
  }

  loadOrder();
</script>
      };
      paymentMethodEl.textContent = paymentNames[orderData.paymentMethod] || orderData.paymentMethod;
    }

    // Save to order history
    const orderHistory = JSON.parse(localStorage.getItem('roquace_order_history') || '[]');
    orderHistory.unshift({
      ...orderData,
      status: 'Processing',
      estimatedDelivery: `${formatDate(3)} - ${formatDate(5)}`
    });
    localStorage.setItem('roquace_order_history', JSON.stringify(orderHistory));

  } catch (e) {
    console.error('Error loading order data:', e);
    window.location.href = '/shop';
  }
</script>
