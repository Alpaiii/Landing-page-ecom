---
import Layout from '../../layouts/Layout.astro';

const title = 'Admin Dashboard';
---

<Layout title={title}>
  <!-- Auth Check - Redirect if not logged in -->
  <div id="auth-check" class="hidden">
    <div class="min-h-screen flex items-center justify-center">
      <div class="text-center">
        <p class="text-lg font-body mb-4">Checking authentication...</p>
      </div>
    </div>
  </div>

  <!-- Main Dashboard -->
  <div id="dashboard-content" class="hidden">
    <div class="min-h-screen bg-background">
      <!-- Header -->
      <header class="bg-foreground text-background">
        <div class="container mx-auto px-4 py-4">
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-2xl font-heading">Admin Dashboard</h1>
              <p class="text-sm text-background/70 font-body">Manage your store</p>
            </div>
            <div class="flex items-center gap-4">
              <span id="admin-email" class="text-sm font-body"></span>
              <button
                id="logout-btn"
                class="px-4 py-2 bg-background text-foreground text-sm font-body uppercase tracking-wider hover:bg-background/90"
              >
                Logout
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Navigation -->
      <nav class="bg-background border-b border-border">
        <div class="container mx-auto px-4">
          <div class="flex gap-8">
            <button
              data-tab="products"
              class="tab-btn active px-4 py-4 font-body text-sm uppercase tracking-wider border-b-2 border-foreground"
            >
              Products
            </button>
            <button
              data-tab="collections"
              class="tab-btn px-4 py-4 font-body text-sm uppercase tracking-wider border-b-2 border-transparent hover:border-foreground/20"
            >
              Collections
            </button>
            <button
              data-tab="orders"
              class="tab-btn px-4 py-4 font-body text-sm uppercase tracking-wider border-b-2 border-transparent hover:border-foreground/20"
            >
              Orders
            </button>
            <button
              data-tab="reviews"
              class="tab-btn px-4 py-4 font-body text-sm uppercase tracking-wider border-b-2 border-transparent hover:border-foreground/20"
            >
              Reviews
            </button>
            <button
              data-tab="coupons"
              class="tab-btn px-4 py-4 font-body text-sm uppercase tracking-wider border-b-2 border-transparent hover:border-foreground/20"
            >
              Coupons
            </button>
            <button
              data-tab="customers"
              class="tab-btn px-4 py-4 font-body text-sm uppercase tracking-wider border-b-2 border-transparent hover:border-foreground/20"
            >
              Customers
            </button>
          </div>
        </div>
      </nav>

      <!-- Content Area -->
      <main class="container mx-auto px-4 py-8">
        <!-- Products Tab -->
        <div id="tab-products" class="tab-content">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-heading">Products</h2>
            <a
              href="/admin/products/add"
              class="px-6 py-3 bg-foreground text-background font-body uppercase tracking-wider hover:bg-foreground/90"
            >
              Add Product
            </a>
          </div>

          <!-- Products List -->
          <input
            id="products-search"
            type="search"
            placeholder="Search products..."
            class="w-full mb-4 px-4 py-2.5 border border-border font-body text-sm focus:outline-none focus:border-foreground"
          />

          <div id="products-loading" class="text-center py-12">
            <p class="font-body text-foreground/60">Loading products...</p>
          </div>

          <div id="products-list" class="hidden">
            <div class="bg-background border border-border">
              <table class="w-full">
                <thead class="border-b border-border">
                  <tr>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Image</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Name</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Price</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Stock</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Status</th>
                    <th class="px-4 py-3 text-right text-sm font-body uppercase tracking-wider">Actions</th>
                  </tr>
                </thead>
                <tbody id="products-tbody" class="divide-y divide-border">
                  <!-- Populated by JS -->
                </tbody>
              </table>
            </div>
            <div id="products-pagination" class="flex flex-wrap gap-2 mt-4"></div>
          </div>
        </div>

        <!-- Collections Tab -->
        <div id="tab-collections" class="tab-content hidden">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-heading">Collections</h2>
          </div>

          <div id="collections-loading" class="text-center py-12">
            <p class="font-body text-foreground/60">Loading collections...</p>
          </div>

          <input
            id="collections-search"
            type="search"
            placeholder="Search collections..."
            class="w-full mb-4 px-4 py-2.5 border border-border font-body text-sm focus:outline-none focus:border-foreground"
          />

          <div id="collections-list" class="hidden grid gap-6">
            <!-- Populated by JS -->
          </div>
          <div id="collections-pagination" class="flex flex-wrap gap-2 mt-4"></div>
        </div>

        <!-- Orders Tab -->
        <div id="tab-orders" class="tab-content hidden">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-heading">Orders</h2>
          </div>

          <div id="orders-loading" class="text-center py-12">
            <p class="font-body text-foreground/60">Loading orders...</p>
          </div>

          <input
            id="orders-search"
            type="search"
            placeholder="Search orders by customer or status..."
            class="w-full mb-4 px-4 py-2.5 border border-border font-body text-sm focus:outline-none focus:border-foreground"
          />

          <div id="orders-list" class="hidden">
            <div class="bg-background border border-border overflow-x-auto">
              <table class="w-full">
                <thead class="border-b border-border">
                  <tr>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Order</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Customer</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Total</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Date</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Status</th>
                  </tr>
                </thead>
                <tbody id="orders-tbody" class="divide-y divide-border">
                  <!-- Populated by JS -->
                </tbody>
              </table>
            </div>
            <div id="orders-pagination" class="flex flex-wrap gap-2 mt-4"></div>
          </div>
        </div>

        <!-- Reviews Tab -->
        <div id="tab-reviews" class="tab-content hidden">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-heading">Reviews</h2>
          </div>

          <div id="reviews-loading" class="text-center py-12">
            <p class="font-body text-foreground/60">Loading reviews...</p>
          </div>

          <input
            id="reviews-search"
            type="search"
            placeholder="Search reviews..."
            class="w-full mb-4 px-4 py-2.5 border border-border font-body text-sm focus:outline-none focus:border-foreground"
          />

          <div id="reviews-list" class="hidden grid gap-4">
            <!-- Populated by JS -->
          </div>
          <div id="reviews-pagination" class="flex flex-wrap gap-2 mt-4"></div>
        </div>

        <!-- Coupons Tab -->
        <div id="tab-coupons" class="tab-content hidden">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-heading">Coupons</h2>
          </div>

          <form id="coupon-form" class="border border-border p-6 mb-8 grid gap-4 md:grid-cols-3">
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-code">Code *</label>
              <input id="coupon-code" name="code" required class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-type">Type *</label>
              <select id="coupon-type" name="discount_type" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground">
                <option value="percentage">Percentage</option>
                <option value="fixed">Fixed amount</option>
              </select>
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-value">Value *</label>
              <input id="coupon-value" name="discount_value" type="number" min="0" step="0.01" required class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-min">Min purchase</label>
              <input id="coupon-min" name="min_purchase" type="number" min="0" step="0.01" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-max">Max discount</label>
              <input id="coupon-max" name="max_discount" type="number" min="0" step="0.01" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-usage">Usage limit</label>
              <input id="coupon-usage" name="usage_limit" type="number" min="0" step="1" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-valid-from">Valid from</label>
              <input id="coupon-valid-from" name="valid_from" type="date" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div>
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-valid-until">Valid until</label>
              <input id="coupon-valid-until" name="valid_until" type="date" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div class="md:col-span-3">
              <label class="block text-xs tracking-wider uppercase font-body mb-2" for="coupon-description">Description</label>
              <input id="coupon-description" name="description" class="w-full px-3 py-2 border border-border font-body text-sm focus:outline-none focus:border-foreground" />
            </div>
            <div class="md:col-span-3 flex items-center justify-between gap-4">
              <label class="flex items-center gap-2 font-body text-sm">
                <input id="coupon-active" name="is_active" type="checkbox" checked />
                Active
              </label>
              <div class="flex items-center gap-4">
                <span id="coupon-error" class="hidden text-sm text-red-600 font-body"></span>
                <button type="submit" class="px-6 py-2.5 bg-foreground text-background font-body uppercase tracking-wider text-sm">Create Coupon</button>
              </div>
            </div>
          </form>

          <div id="coupons-loading" class="text-center py-12">
            <p class="font-body text-foreground/60">Loading coupons...</p>
          </div>

          <input
            id="coupons-search"
            type="search"
            placeholder="Search coupons..."
            class="w-full mb-4 px-4 py-2.5 border border-border font-body text-sm focus:outline-none focus:border-foreground"
          />

          <div id="coupons-list" class="hidden">
            <div class="bg-background border border-border overflow-x-auto">
              <table class="w-full">
                <thead class="border-b border-border">
                  <tr>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Code</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Discount</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Min</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Usage</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Valid until</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Status</th>
                    <th class="px-4 py-3 text-right text-sm font-body uppercase tracking-wider">Actions</th>
                  </tr>
                </thead>
                <tbody id="coupons-tbody" class="divide-y divide-border"></tbody>
              </table>
            </div>
            <div id="coupons-pagination" class="flex flex-wrap gap-2 mt-4"></div>
          </div>
        </div>

        <!-- Customers Tab -->
        <div id="tab-customers" class="tab-content hidden">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-heading">Customers</h2>
          </div>

          <div id="customers-loading" class="text-center py-12">
            <p class="font-body text-foreground/60">Loading customers...</p>
          </div>

          <input
            id="customers-search"
            type="search"
            placeholder="Search customers..."
            class="w-full mb-4 px-4 py-2.5 border border-border font-body text-sm focus:outline-none focus:border-foreground"
          />

          <div id="customers-list" class="hidden">
            <div class="bg-background border border-border overflow-x-auto">
              <table class="w-full">
                <thead class="border-b border-border">
                  <tr>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Name</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Email</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Phone</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Orders</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Total spent</th>
                    <th class="px-4 py-3 text-left text-sm font-body uppercase tracking-wider">Joined</th>
                  </tr>
                </thead>
                <tbody id="customers-tbody" class="divide-y divide-border"></tbody>
              </table>
            </div>
            <div id="customers-pagination" class="flex flex-wrap gap-2 mt-4"></div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || '/api';

  // Escape user-controlled values before putting them into innerHTML.
  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatPrice(value: unknown): string {
    const n = Number(value);
    return Number.isFinite(n) ? n.toLocaleString('id-ID') : '0';
  }

  function formatDate(value: unknown): string {
    const d = new Date(String(value));
    return Number.isNaN(d.getTime())
      ? ''
      : d.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  /**
   * Client-side search + pagination for an already-rendered list.
   * Re-run after every reload so the captured rows stay current.
   */
  function setupListControls(
    containerId: string,
    searchId: string,
    pagerId: string,
    perPage = 10
  ): void {
    const container = document.getElementById(containerId);
    if (!container) return;

    const search = document.getElementById(searchId) as HTMLInputElement | null;
    const pager = document.getElementById(pagerId);
    const items = Array.from(container.children) as HTMLElement[];
    let page = 1;

    const apply = () => {
      const query = (search?.value || '').toLowerCase().trim();
      const filtered = items.filter(
        (item) => !query || (item.textContent || '').toLowerCase().includes(query)
      );
      const pages = Math.max(1, Math.ceil(filtered.length / perPage));
      page = Math.min(page, pages);

      items.forEach((item) => item.classList.add('hidden'));
      filtered
        .slice((page - 1) * perPage, page * perPage)
        .forEach((item) => item.classList.remove('hidden'));

      if (!pager) return;
      pager.innerHTML = '';
      if (pages <= 1) return;

      for (let i = 1; i <= pages; i += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(i);
        button.className = `px-3 py-1.5 border font-body text-sm ${
          i === page
            ? 'bg-foreground text-background border-foreground'
            : 'border-border hover:bg-foreground/5'
        }`;
        button.addEventListener('click', () => {
          page = i;
          apply();
        });
        pager.appendChild(button);
      }
    };

    if (search) search.oninput = () => { page = 1; apply(); };
    apply();
  }

  const authCheck = document.getElementById('auth-check');
  const dashboardContent = document.getElementById('dashboard-content');
  const adminEmail = document.getElementById('admin-email');
  const logoutBtn = document.getElementById('logout-btn');

  // Check authentication
  async function checkAuth() {
    authCheck?.classList.remove('hidden');
    
    try {
      const response = await fetch(`${API_URL}/auth/verify`);

      if (!response.ok) {
        localStorage.removeItem('admin_token');
        window.location.href = '/admin/login';
        return;
      }

      const result = await response.json();
      
      // Show dashboard
      authCheck?.classList.add('hidden');
      dashboardContent?.classList.remove('hidden');
      
      if (adminEmail && result.admin) {
        adminEmail.textContent = result.admin.email || '';
      }
      
      // Load data
      loadProducts();
      loadCollections();
      loadOrders();
      loadReviews();
      loadCoupons();
      loadCustomers();
      
    } catch (error) {
      console.error('Auth error:', error);
      window.location.href = '/admin/login';
    }
  }

  // Logout
  logoutBtn?.addEventListener('click', async () => {
    try {
      await fetch(`${API_URL}/auth/logout`, { method: 'POST' });
    } catch {
      // Ignore network errors: the redirect still clears the UI.
    }
    localStorage.removeItem('admin_token');
    window.location.href = '/admin/login';
  });

  // Tab switching
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = (btn as HTMLElement).dataset.tab;
      
      // Update buttons
      tabBtns.forEach((b) => {
        b.classList.remove('active', 'border-foreground');
        b.classList.add('border-transparent');
      });
      btn.classList.add('active', 'border-foreground');
      btn.classList.remove('border-transparent');
      
      // Update content
      tabContents.forEach((content) => {
        content.classList.add('hidden');
      });
      document.getElementById(`tab-${tabName}`)?.classList.remove('hidden');
    });
  });

  // Load products
  async function loadProducts() {
    const loading = document.getElementById('products-loading');
    const list = document.getElementById('products-list');
    const tbody = document.getElementById('products-tbody');
    
    try {
      const response = await fetch(`${API_URL}/products`);
      
      if (!response.ok) throw new Error('Failed to fetch');
      const result = await response.json();
      const products = result.data || [];
      
      loading?.classList.add('hidden');
      list?.classList.remove('hidden');
      
      if (tbody && products) {
        tbody.innerHTML = products.map((product: any) => `
          <tr>
            <td class="px-4 py-3">
              <img src="${escapeHtml(product.images?.[0] || '/images/placeholder.jpg')}" alt="${escapeHtml(product.name)}" class="w-16 h-20 object-cover" />
            </td>
            <td class="px-4 py-3 font-body">${escapeHtml(product.name)}</td>
            <td class="px-4 py-3 font-body">Rp${formatPrice(product.price)}</td>
            <td class="px-4 py-3 font-body">${escapeHtml(product.stock ?? 0)}</td>
            <td class="px-4 py-3">
              ${product.is_featured ? '<span class="px-2 py-1 text-xs bg-accent text-white">Featured</span>' : ''}
              ${product.is_new ? '<span class="px-2 py-1 text-xs bg-foreground text-background ml-1">New</span>' : ''}
            </td>
            <td class="px-4 py-3 text-right">
              <a href="/admin/products/edit?id=${encodeURIComponent(product.id)}" class="text-sm text-foreground hover:underline mr-4">Edit</a>
              <button data-delete-id="${escapeHtml(product.id)}" class="delete-product text-sm text-red-600 hover:underline">Delete</button>
            </td>
          </tr>
        `).join('');
      }

      setupListControls('products-tbody', 'products-search', 'products-pagination');
      
    } catch (error) {
      console.error('Error loading products:', error);
      if (loading) loading.innerHTML = '<p class="text-red-600">Error loading products</p>';
    }
  }

  // Load collections
  async function loadCollections() {
    const loading = document.getElementById('collections-loading');
    const list = document.getElementById('collections-list');
    
    try {
      const response = await fetch(`${API_URL}/collections`);
      if (!response.ok) throw new Error('Failed to fetch');
      const result = await response.json();
      const collections = result.data || [];
      
      loading?.classList.add('hidden');
      list?.classList.remove('hidden');
      
      if (list && collections) {
        list.innerHTML = collections.map((collection: any) => `
          <div class="border border-border p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-heading mb-1">${escapeHtml(collection.name)}</h3>
                <p class="text-sm text-foreground/60 font-body">${escapeHtml(collection.short_description || '')}</p>
              </div>
              ${collection.is_featured ? '<span class="px-3 py-1 text-xs bg-accent text-white">Featured</span>' : ''}
            </div>
            <p class="text-sm font-body text-foreground/80 mb-4">${escapeHtml(collection.description || '')}</p>
            <div class="flex items-center justify-between">
              <span class="text-sm font-body text-foreground/60">Slug: ${escapeHtml(collection.slug)}</span>
            </div>
          </div>
        `).join('');
      }

      setupListControls('collections-list', 'collections-search', 'collections-pagination', 6);
      
    } catch (error) {
      console.error('Error loading collections:', error);
      if (loading) loading.innerHTML = '<p class="text-red-600">Error loading collections</p>';
    }
  }

  // Load orders
  async function loadOrders() {
    const loading = document.getElementById('orders-loading');
    const list = document.getElementById('orders-list');
    const tbody = document.getElementById('orders-tbody');

    try {
      const response = await fetch(`${API_URL}/orders`);

      if (!response.ok) throw new Error('Failed to fetch orders');
      const result = await response.json();
      const orders = result.data || [];

      loading?.classList.add('hidden');
      list?.classList.remove('hidden');

      if (tbody) {
        if (orders.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center font-body text-foreground/60">No orders yet.</td></tr>';
        } else {
          const statuses = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
          tbody.innerHTML = orders.map((order: any) => `
            <tr>
              <td class="px-4 py-3 font-body text-xs">${escapeHtml(String(order.id).slice(0, 8))}…</td>
              <td class="px-4 py-3 font-body">
                <div>${escapeHtml(order.customer_name)}</div>
                <div class="text-xs text-foreground/60">${escapeHtml(order.customer_email)}</div>
              </td>
              <td class="px-4 py-3 font-body">Rp${formatPrice(order.total_amount)}</td>
              <td class="px-4 py-3 font-body text-sm">${escapeHtml(formatDate(order.created_at))}</td>
              <td class="px-4 py-3">
                <select data-order-id="${escapeHtml(order.id)}" class="order-status px-2 py-1 border border-border font-body text-sm">
                  ${statuses.map((s) => `<option value="${s}" ${s === order.status ? 'selected' : ''}>${s}</option>`).join('')}
                </select>
              </td>
            </tr>
          `).join('');
        }
      }

      setupListControls('orders-tbody', 'orders-search', 'orders-pagination');
    } catch (error) {
      console.error('Error loading orders:', error);
      if (loading) loading.innerHTML = '<p class="text-red-600">Error loading orders</p>';
    }
  }

  async function updateOrderStatus(id: string, status: string) {
    try {
      const response = await fetch(`${API_URL}/orders/${encodeURIComponent(id)}/status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ status })
      });

      if (!response.ok) throw new Error('Failed to update order');
    } catch (error) {
      console.error('Error updating order:', error);
      alert('Failed to update order status');
      loadOrders();
    }
  }

  // Load reviews
  async function loadReviews() {
    const loading = document.getElementById('reviews-loading');
    const list = document.getElementById('reviews-list');

    try {
      const response = await fetch(`${API_URL}/reviews/admin/all`);

      if (!response.ok) throw new Error('Failed to fetch reviews');
      const result = await response.json();
      const reviews = result.data || [];

      loading?.classList.add('hidden');
      list?.classList.remove('hidden');

      if (list) {
        if (reviews.length === 0) {
          list.innerHTML = '<p class="font-body text-foreground/60">No reviews yet.</p>';
        } else {
          list.innerHTML = reviews.map((review: any) => {
            const rating = Number(review.rating) || 0;
            return `
              <div class="border border-border p-6">
                <div class="flex items-start justify-between gap-4 mb-2">
                  <div>
                    <div class="font-body font-medium">${escapeHtml(review.customer_name)}</div>
                    <div class="text-sm text-accent">${'★'.repeat(rating)}${'☆'.repeat(Math.max(0, 5 - rating))}</div>
                  </div>
                  <span class="text-xs px-2 py-1 ${review.is_approved ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                    ${review.is_approved ? 'Approved' : 'Pending'}
                  </span>
                </div>
                ${review.title ? `<div class="font-body font-medium mt-2">${escapeHtml(review.title)}</div>` : ''}
                <p class="font-body text-sm text-foreground/80 mt-1">${escapeHtml(review.comment || '')}</p>
                <div class="flex gap-4 mt-4">
                  ${review.is_approved
                    ? `<button data-review-action="reject" data-review-id="${escapeHtml(review.id)}" class="text-sm text-yellow-700 hover:underline">Unapprove</button>`
                    : `<button data-review-action="approve" data-review-id="${escapeHtml(review.id)}" class="text-sm text-green-700 hover:underline">Approve</button>`}
                  <button data-review-action="delete" data-review-id="${escapeHtml(review.id)}" class="text-sm text-red-600 hover:underline">Delete</button>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      setupListControls('reviews-list', 'reviews-search', 'reviews-pagination', 6);
    } catch (error) {
      console.error('Error loading reviews:', error);
      if (loading) loading.innerHTML = '<p class="text-red-600">Error loading reviews</p>';
    }
  }

  // Order status change
  document.getElementById('orders-tbody')?.addEventListener('change', (event) => {
    const select = event.target as HTMLSelectElement;
    if (!select.classList.contains('order-status')) return;
    const id = select.dataset.orderId;
    if (id) updateOrderStatus(id, select.value);
  });

  // Review actions
  document.getElementById('reviews-list')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-review-action]');
    if (!button) return;

    const id = button.dataset.reviewId;
    const action = button.dataset.reviewAction;
    if (!id || !action) return;

    try {
      const response = action === 'delete'
        ? await fetch(`${API_URL}/reviews/admin/${encodeURIComponent(id)}`, {
            method: 'DELETE'
          })
        : await fetch(`${API_URL}/reviews/${encodeURIComponent(id)}/approve`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ is_approved: action === 'approve' })
          });

      if (!response.ok) throw new Error('Failed to update review');
      loadReviews();
    } catch (error) {
      console.error('Error updating review:', error);
      alert('Failed to update review');
    }
  });

  // Delete product
  async function deleteProduct(id: string) {
    if (!confirm('Are you sure you want to delete this product?')) return;
    
    try {
      const response = await fetch(`${API_URL}/products/${id}`, {
        method: 'DELETE'
      });
      
      if (!response.ok) throw new Error('Failed to delete');
      
      // Reload products
      loadProducts();
      
    } catch (error) {
      console.error('Error deleting product:', error);
      alert('Failed to delete product');
    }
  }

  // Event delegation for delete buttons (avoids inline handlers + injected attributes).
  document.getElementById('products-tbody')?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>('.delete-product');
    const id = button?.dataset.deleteId;
    if (id) deleteProduct(id);
  });

  // Load coupons
  async function loadCoupons() {
    const loading = document.getElementById('coupons-loading');
    const list = document.getElementById('coupons-list');
    const tbody = document.getElementById('coupons-tbody');

    try {
      const response = await fetch(`${API_URL}/coupons`);
      if (!response.ok) throw new Error('Failed to fetch coupons');
      const result = await response.json();
      const coupons = result.data || [];

      loading?.classList.add('hidden');
      list?.classList.remove('hidden');

      if (tbody) {
        if (coupons.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center font-body text-foreground/60">No coupons yet.</td></tr>';
        } else {
          tbody.innerHTML = coupons.map((coupon: any) => {
            const value = coupon.discount_type === 'percentage'
              ? `${Number(coupon.discount_value)}%`
              : `Rp${formatPrice(coupon.discount_value)}`;
            const usage = coupon.usage_limit
              ? `${coupon.usage_count ?? 0}/${coupon.usage_limit}`
              : String(coupon.usage_count ?? 0);

            return `
              <tr>
                <td class="px-4 py-3 font-body font-medium">${escapeHtml(coupon.code)}</td>
                <td class="px-4 py-3 font-body">${escapeHtml(value)}</td>
                <td class="px-4 py-3 font-body">Rp${formatPrice(coupon.min_purchase)}</td>
                <td class="px-4 py-3 font-body">${escapeHtml(usage)}</td>
                <td class="px-4 py-3 font-body text-sm">${escapeHtml(coupon.valid_until ? formatDate(coupon.valid_until) : '—')}</td>
                <td class="px-4 py-3">
                  <span class="text-xs px-2 py-1 ${coupon.is_active ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-700'}">
                    ${coupon.is_active ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="px-4 py-3 text-right">
                  <button data-coupon-action="toggle" data-coupon-id="${escapeHtml(coupon.id)}" data-coupon-active="${coupon.is_active ? 'true' : 'false'}" class="text-sm text-foreground hover:underline mr-4">
                    ${coupon.is_active ? 'Deactivate' : 'Activate'}
                  </button>
                  <button data-coupon-action="delete" data-coupon-id="${escapeHtml(coupon.id)}" class="text-sm text-red-600 hover:underline">Delete</button>
                </td>
              </tr>
            `;
          }).join('');
        }
      }

      setupListControls('coupons-tbody', 'coupons-search', 'coupons-pagination');
    } catch (error) {
      console.error('Error loading coupons:', error);
      if (loading) loading.innerHTML = '<p class="text-red-600">Error loading coupons</p>';
    }
  }

  // Load customers
  async function loadCustomers() {
    const loading = document.getElementById('customers-loading');
    const list = document.getElementById('customers-list');
    const tbody = document.getElementById('customers-tbody');

    try {
      const response = await fetch(`${API_URL}/customers/admin/all`);
      if (!response.ok) throw new Error('Failed to fetch customers');
      const result = await response.json();
      const customers = result.data || [];

      loading?.classList.add('hidden');
      list?.classList.remove('hidden');

      if (tbody) {
        if (customers.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center font-body text-foreground/60">No customers yet.</td></tr>';
        } else {
          tbody.innerHTML = customers.map((customer: any) => `
            <tr>
              <td class="px-4 py-3 font-body">${escapeHtml(customer.name)}</td>
              <td class="px-4 py-3 font-body text-sm">${escapeHtml(customer.email)}</td>
              <td class="px-4 py-3 font-body text-sm">${escapeHtml(customer.phone || '—')}</td>
              <td class="px-4 py-3 font-body">${escapeHtml(customer.order_count ?? 0)}</td>
              <td class="px-4 py-3 font-body">Rp${formatPrice(customer.total_spent)}</td>
              <td class="px-4 py-3 font-body text-sm">${escapeHtml(formatDate(customer.created_at))}</td>
            </tr>
          `).join('');
        }
      }

      setupListControls('customers-tbody', 'customers-search', 'customers-pagination');
    } catch (error) {
      console.error('Error loading customers:', error);
      if (loading) loading.innerHTML = '<p class="text-red-600">Error loading customers</p>';
    }
  }

  // Create coupon
  document.getElementById('coupon-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const errorEl = document.getElementById('coupon-error');
    const formData = new FormData(form);

    const numberOrNull = (value: FormDataEntryValue | null) =>
      value === null || value === '' ? null : Number(value);

    const payload = {
      code: String(formData.get('code') || ''),
      description: formData.get('description') || null,
      discount_type: formData.get('discount_type'),
      discount_value: Number(formData.get('discount_value')),
      min_purchase: numberOrNull(formData.get('min_purchase')) ?? 0,
      max_discount: numberOrNull(formData.get('max_discount')),
      usage_limit: numberOrNull(formData.get('usage_limit')),
      valid_from: formData.get('valid_from') || null,
      valid_until: formData.get('valid_until') || null,
      is_active: formData.get('is_active') === 'on'
    };

    try {
      errorEl?.classList.add('hidden');
      const response = await fetch(`${API_URL}/coupons`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error || 'Failed to create coupon');
      }

      form.reset();
      const active = document.getElementById('coupon-active') as HTMLInputElement | null;
      if (active) active.checked = true;
      loadCoupons();
    } catch (error: any) {
      if (errorEl) {
        errorEl.textContent = error.message || 'Failed to create coupon';
        errorEl.classList.remove('hidden');
      }
    }
  });

  // Coupon actions
  document.getElementById('coupons-tbody')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-coupon-id]');
    if (!button) return;

    const id = button.dataset.couponId;
    const action = button.dataset.couponAction;
    if (!id || !action) return;

    try {
      if (action === 'delete') {
        if (!confirm('Delete this coupon?')) return;
        const response = await fetch(`${API_URL}/coupons/${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (!response.ok) throw new Error('Failed to delete coupon');
      } else {
        const response = await fetch(`${API_URL}/coupons/${encodeURIComponent(id)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_active: button.dataset.couponActive !== 'true' })
        });
        if (!response.ok) throw new Error('Failed to update coupon');
      }

      loadCoupons();
    } catch (error) {
      console.error('Coupon action error:', error);
      alert('Failed to update coupon');
    }
  });

  // Initialize
  checkAuth();
</script>
