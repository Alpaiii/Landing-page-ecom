---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'My Account';
const description = 'Manage your account';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom">
        <!-- Header -->
        <div class="mb-12">
          <h1 class="text-3xl md:text-4xl font-heading mb-2">My Account</h1>
          <p id="user-email" class="text-foreground/70 font-body"></p>
        </div>

        <div class="grid lg:grid-cols-4 gap-8">
          <!-- Sidebar Navigation -->
          <div class="lg:col-span-1">
            <nav class="space-y-2 sticky top-36">
              <a
                href="/account"
                class="account-nav-link active flex items-center gap-3 px-4 py-3 text-sm font-body hover:bg-foreground/5 transition-colors"
                data-section="dashboard"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Dashboard
              </a>
              <a
                href="/account/orders"
                class="account-nav-link flex items-center gap-3 px-4 py-3 text-sm font-body hover:bg-foreground/5 transition-colors"
                data-section="orders"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                Orders
              </a>
              <a
                href="/wishlist"
                class="account-nav-link flex items-center gap-3 px-4 py-3 text-sm font-body hover:bg-foreground/5 transition-colors"
                data-section="wishlist"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                Wishlist
              </a>
              <a
                href="/account/addresses"
                class="account-nav-link flex items-center gap-3 px-4 py-3 text-sm font-body hover:bg-foreground/5 transition-colors"
                data-section="addresses"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Addresses
              </a>
              <a
                href="/account/settings"
                class="account-nav-link flex items-center gap-3 px-4 py-3 text-sm font-body hover:bg-foreground/5 transition-colors"
                data-section="settings"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Settings
              </a>
              <button
                id="logout-btn"
                class="w-full flex items-center gap-3 px-4 py-3 text-sm font-body text-red-500 hover:bg-red-500/10 transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                Logout
              </button>
            </nav>
          </div>

          <!-- Content -->
          <div class="lg:col-span-3">
            <!-- Dashboard Section -->
            <div id="dashboard-section">
              <div class="mb-8">
                <h2 class="text-2xl font-heading mb-4">
                  Welcome back, <span id="user-name"></span>!
                </h2>
                <p class="text-foreground/70 font-body">Here's what's happening with your account</p>
              </div>

              <!-- Quick Stats -->
              <div class="grid md:grid-cols-3 gap-6 mb-8">
                <div class="border border-border p-6">
                  <div class="flex items-center gap-4 mb-3">
                    <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center">
                      <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                      </svg>
                    </div>
                    <div>
                      <p class="text-2xl font-heading" id="total-orders">0</p>
                      <p class="text-sm text-foreground/60 font-body">Total Orders</p>
                    </div>
                  </div>
                </div>

                <div class="border border-border p-6">
                  <div class="flex items-center gap-4 mb-3">
                    <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center">
                      <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                      </svg>
                    </div>
                    <div>
                      <p class="text-2xl font-heading" id="wishlist-count">0</p>
                      <p class="text-sm text-foreground/60 font-body">Wishlist Items</p>
                    </div>
                  </div>
                </div>

                <div class="border border-border p-6">
                  <div class="flex items-center gap-4 mb-3">
                    <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center">
                      <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    </div>
                    <div>
                      <p class="text-2xl font-heading" id="addresses-count">0</p>
                      <p class="text-sm text-foreground/60 font-body">Saved Addresses</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Recent Orders -->
              <div class="border border-border p-6">
                <div class="flex items-center justify-between mb-6">
                  <h3 class="text-lg tracking-wider uppercase font-body">Recent Orders</h3>
                  <a href="/account/orders" class="text-sm font-body text-foreground/70 hover:text-foreground underline">
                    View All
                  </a>
                </div>
                <div id="recent-orders-dashboard">
                  <!-- Populated by JavaScript -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .account-nav-link.active {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
</style>

<script>
  function formatPrice(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(price);
  }

  function formatDate(dateString: string): string {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  }

  // Check authentication
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';

  async function loadAccountData() {
    try {
      // Check token
      const token = localStorage.getItem('customer_token');
      
      if (!token) {
        window.location.href = '/login?return=/account';
        return;
      }

      // Verify token and get customer data
      const response = await fetch(`${API_URL}/api/customers/customer-verify`, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (!response.ok) {
        throw new Error('Invalid token');
      }

      const result = await response.json();
      const customer = result.customer;

      // Display user info
      const userEmail = document.getElementById('user-email');
      const userName = document.getElementById('user-name');
      
      if (userEmail) userEmail.textContent = customer.email;
      if (userName) userName.textContent = customer.name?.split(' ')[0] || 'there';

      // Fetch orders
      const ordersResponse = await fetch(`${API_URL}/api/customers/orders`, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      let orders = [];
      if (ordersResponse.ok) {
        const ordersResult = await ordersResponse.json();
        orders = ordersResult.data || [];
      }

      // Fetch addresses
      const addressesResponse = await fetch(`${API_URL}/api/customers/addresses`, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      let addresses = [];
      if (addressesResponse.ok) {
        const addressesResult = await addressesResponse.json();
        addresses = addressesResult.data || [];
      }

      // Get wishlist from localStorage
      const wishlist = JSON.parse(localStorage.getItem('roquace-wishlist') || '[]');

      // Update stats
      const totalOrdersEl = document.getElementById('total-orders');
      const wishlistCountEl = document.getElementById('wishlist-count');
      const addressesCountEl = document.getElementById('addresses-count');

      if (totalOrdersEl) totalOrdersEl.textContent = String(orders.length);
      if (wishlistCountEl) wishlistCountEl.textContent = String(wishlist.length);
      if (addressesCountEl) addressesCountEl.textContent = String(addresses.length);

      // Load recent orders
      const recentOrdersEl = document.getElementById('recent-orders-dashboard');
      if (recentOrdersEl) {
        if (orders.length === 0) {
          recentOrdersEl.innerHTML = `
            <div class="text-center py-8">
              <p class="text-foreground/60 font-body mb-4">No orders yet</p>
              <a href="/shop" class="btn-secondary inline-block">Start Shopping</a>
            </div>
          `;
        } else {
          recentOrdersEl.innerHTML = orders.slice(0, 3).map((order: any) => `
            <div class="flex items-center justify-between py-4 border-b border-border last:border-0">
              <div>
                <p class="font-body font-medium mb-1">Order #${order.id.substring(0, 8)}</p>
                <p class="text-sm text-foreground/60 font-body">${formatDate(order.created_at)}</p>
              </div>
              <div class="text-right">
                <p class="font-body font-medium mb-1">${formatPrice(order.total_amount)}</p>
                <span class="text-xs px-2 py-1 bg-accent/10 text-accent rounded capitalize">${order.status}</span>
              </div>
            </div>
          `).join('');
        }
      }

    } catch (e) {
      console.error('Session error:', e);
      localStorage.removeItem('customer_token');
      localStorage.removeItem('roquace_session');
      window.location.href = '/login?return=/account';
    }
  }

  // Load account data
  loadAccountData();

  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    if (confirm('Are you sure you want to logout?')) {
      localStorage.removeItem('customer_token');
      localStorage.removeItem('roquace_session');
      window.location.href = '/';
    }
  });
</script>
