---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CollectionCard from '../components/CollectionCard.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import BrandStory from '../components/BrandStory.astro';
import USP from '../components/USP.astro';
import Lookbook from '../components/Lookbook.astro';
import Testimonials from '../components/Testimonials.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';
import { collections } from '../data/collections';

const featuredProducts = products.filter(p => p.badge === 'New' || p.badge === 'Best Seller').slice(0, 4);
---

<Layout>
  <AnnouncementBar />
  <Navbar />

  <main>
    <Hero />

    <!-- Featured Collections -->
    <section id="collections" class="section-padding">
      <div class="container-custom">
        <div class="text-center mb-12 md:mb-16">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">Collections</p>
          <h2 class="heading-lg">Featured Collection</h2>
        </div>
        <div class="grid md:grid-cols-12 gap-6">
          <div class="md:col-span-8">
            <CollectionCard
              name={collections[0].name}
              description={collections[0].description}
              image={collections[0].image}
              slug={collections[0].slug}
              featured={true}
            />
          </div>
          <div class="md:col-span-4 grid grid-cols-1 gap-6">
            <CollectionCard
              name={collections[1].name}
              description={collections[1].description}
              image={collections[1].image}
              slug={collections[1].slug}
            />
            <CollectionCard
              name={collections[2].name}
              description={collections[2].description}
              image={collections[2].image}
              slug={collections[2].slug}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- New Arrivals -->
    <section class="section-padding bg-background overflow-x-hidden">
      <div class="container-custom">
        <div class="text-center mb-14 md:mb-20">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">Fresh Drops</p>
          <h2 class="heading-lg mb-5">New Arrivals</h2>
          <div class="editorial-divider mx-auto"></div>
        </div>
      </div>
      <div class="px-6 sm:px-8 lg:px-12">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 lg:gap-x-10">
          {featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
      <div class="text-center mt-14 md:mt-20">
        <a href="/shop" class="btn-secondary">
          View All Products
        </a>
      </div>
    </section>

    <CategoryGrid />
    <BrandStory />
    <USP />
    <Lookbook />
    <Testimonials />
    <InstagramGrid />
    <FAQ />
    <CTA />
  </main>

  <Footer />
</Layout>
