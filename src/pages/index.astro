---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import CollectionCard from '../components/CollectionCard.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import BrandStory from '../components/BrandStory.astro';
import USP from '../components/USP.astro';
import Lookbook from '../components/Lookbook.astro';
import Testimonials from '../components/Testimonials.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { products, getNewArrivals, getBestSellers } from '../data/products';
import { collections, getFeaturedCollections } from '../data/collections';

const newArrivals = getNewArrivals(4);
const bestSellers = getBestSellers(4);
const featuredCollections = getFeaturedCollections();
---

<Layout>
  <AnnouncementBar />
  <Navbar />

  <main>
    <Hero />
    
    <!-- Trust Metrics -->
    <TrustMetrics />

    <!-- Featured Collections -->
    <section id="collections" class="section-padding">
      <div class="container-custom">
        <div class="text-center mb-12 md:mb-16">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">Collections</p>
          <h2 class="heading-lg">Featured Collection</h2>
        </div>
        <div class="grid md:grid-cols-12 gap-6">
          {featuredCollections.length > 0 && (
            <div class="md:col-span-8">
              <CollectionCard
                name={featuredCollections[0].name}
                description={featuredCollections[0].shortDescription || featuredCollections[0].description}
                image={featuredCollections[0].image}
                slug={featuredCollections[0].slug}
                featured={true}
              />
            </div>
          )}
          <div class="md:col-span-4 grid grid-cols-1 gap-6">
            {featuredCollections.slice(1, 3).map((collection) => (
              <CollectionCard
                name={collection.name}
                description={collection.shortDescription || collection.description}
                image={collection.image}
                slug={collection.slug}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- New Arrivals -->
    <section class="section-padding bg-background overflow-x-hidden">
      <div class="container-custom">
        <div class="text-center mb-14 md:mb-20">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">Fresh Drops</p>
          <h2 class="heading-lg mb-5">New Arrivals</h2>
          <div class="editorial-divider mx-auto"></div>
        </div>
      </div>
      <div class="px-6 sm:px-8 lg:px-12">
        <div class="flex gap-6 md:gap-8 overflow-x-auto snap-x snap-mandatory scroll-px-6 sm:scroll-px-8 lg:scroll-px-12 pb-4 scrollbar-hide">
          {newArrivals.map((product) => (
            <div class="w-[80vw] sm:w-[46vw] md:w-[38vw] lg:w-[30vw] xl:w-[400px] shrink-0 snap-start">
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
      <div class="text-center mt-10 md:mt-14">
        <a href="/shop?filter=new" class="btn-secondary">
          View All New Arrivals
        </a>
      </div>
    </section>

    <CategoryGrid />
    <BrandStory />
    <USP />
    <Lookbook />
    
    <!-- Best Sellers -->
    <section class="section-padding overflow-x-hidden">
      <div class="container-custom">
        <div class="text-center mb-14 md:mb-20">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">Customer Favorites</p>
          <h2 class="heading-lg mb-5">Best Sellers</h2>
          <div class="editorial-divider mx-auto"></div>
        </div>
      </div>
      <div class="px-6 sm:px-8 lg:px-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          {bestSellers.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </div>
      <div class="text-center mt-10 md:mt-14">
        <a href="/shop?filter=bestseller" class="btn-secondary">
          View All Best Sellers
        </a>
      </div>
    </section>
    
    <Testimonials />
    <InstagramGrid />
    <FAQ />
    <CTA />
  </main>

  <Footer />
</Layout>
