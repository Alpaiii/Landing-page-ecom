---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<Layout title="About">
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <!-- Hero -->
    <section class="section-padding">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4">About Us</p>
          <h1 class="heading-xl mb-6">The Story of {siteConfig.name}</h1>
          <p class="text-lg text-foreground/70 font-body">
            Born from a passion for sustainable design, {siteConfig.name} creates canvas bags for the modern adventurer 
            who values both function and form.
          </p>
        </div>
      </div>
    </section>

    <!-- Story -->
    <section class="section-padding bg-background">
      <div class="container-custom">
        <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-center">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src="/images/about/story.jpg"
              alt="Our Story"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <h2 class="heading-lg mb-6">Our Mission</h2>
            <div class="space-y-4 text-foreground/70 font-body">
              <p>
                We believe great bags should be sustainable, functional, and timeless. Our canvas bags 
                are designed to accompany you through life's adventures, big and small.
              </p>
              <p>
                Every bag is crafted with attention to detail, using durable canvas that gets better with age. 
                We focus on quality over quantity, creating pieces that last.
              </p>
              <p>
                From daily commutes to weekend getaways, our bags carry more than just your belongings—
                they carry your story.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="section-padding">
      <div class="container-custom">
        <div class="grid md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="w-12 h-12 mx-auto mb-4 border border-border flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="font-body font-medium mb-2">Durable Canvas</h3>
            <p class="text-sm text-foreground/60 font-body">Heavy-duty materials built to withstand daily use.</p>
          </div>
          <div>
            <div class="w-12 h-12 mx-auto mb-4 border border-border flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-body font-medium mb-2">Eco-Friendly</h3>
            <p class="text-sm text-foreground/60 font-body">Sustainable materials with minimal environmental impact.</p>
          </div>
          <div>
            <div class="w-12 h-12 mx-auto mb-4 border border-border flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-body font-medium mb-2">Timeless Style</h3>
            <p class="text-sm text-foreground/60 font-body">Classic designs that never go out of fashion.</p>
          </div>
          <div>
            <div class="w-12 h-12 mx-auto mb-4 border border-border flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-body font-medium mb-2">Versatile Carry</h3>
            <p class="text-sm text-foreground/60 font-body">Designed for every occasion and adventure.</p>
          </div>
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</Layout>
