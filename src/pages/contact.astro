---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';

const title = 'Contact Us';
const description = 'Get in touch with our customer support team';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-5xl">
        <div class="text-center mb-16">
          <p class="text-sm tracking-[0.3em] uppercase text-muted mb-4 font-body">We're Here To Help</p>
          <h1 class="heading-lg mb-4">Contact Us</h1>
          <p class="text-foreground/60 font-body max-w-xl mx-auto">
            Have questions about a product, your order, or need assistance? Reach out to our team.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <!-- WhatsApp -->
          <div class="border border-border p-8 text-center">
            <div class="w-14 h-14 mx-auto mb-5 rounded-full bg-accent/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.987 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <h3 class="text-lg font-heading mb-2">WhatsApp</h3>
            <p class="text-sm text-foreground/60 font-body mb-4">Fastest response</p>
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp.replace(/[^0-9]/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-body underline hover:no-underline"
            >
              {siteConfig.contact.whatsapp}
            </a>
          </div>

          <!-- Email -->
          <div class="border border-border p-8 text-center">
            <div class="w-14 h-14 mx-auto mb-5 rounded-full bg-accent/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-heading mb-2">Email</h3>
            <p class="text-sm text-foreground/60 font-body mb-4">Replies within 24 hours</p>
            <a href={`mailto:${siteConfig.contact.email}`} class="text-sm font-body underline hover:no-underline">
              {siteConfig.contact.email}
            </a>
          </div>

          <!-- Store Hours -->
          <div class="border border-border p-8 text-center">
            <div class="w-14 h-14 mx-auto mb-5 rounded-full bg-accent/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-heading mb-2">Store Hours</h3>
            <p class="text-sm text-foreground/60 font-body mb-4">Jakarta, Indonesia</p>
            <p class="text-sm font-body">Mon–Fri: 09:00–18:00<br />Sat–Sun: 10:00–16:00</p>
          </div>
        </div>

        <!-- FAQ Link -->
        <div class="text-center pt-12 border-t border-border">
          <p class="text-foreground/60 font-body mb-4">Looking for a quick answer?</p>
          <a href="/faq" class="btn-secondary inline-block">Visit Our FAQ</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>