---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { products } from '../../data/products';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

function formatPrice(price: number): string {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
  }).format(price);
}

const whatsappUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(`Halo, saya tertarik dengan:\n${product.name}\nHarga: ${formatPrice(product.price)}\n\nApakah produk ini masih tersedia?`)}`;
---

<Layout title={product.name} description={product.description}>
  <AnnouncementBar />
  <Navbar />

  <main class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom">
        <div class="grid md:grid-cols-2 gap-8 md:gap-16">
          <!-- Product Image -->
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Product Info -->
          <div class="flex flex-col justify-center">
            {product.badge && (
              <span class="inline-block text-xs tracking-wider uppercase text-accent mb-4 font-body">
                {product.badge}
              </span>
            )}
            <p class="text-sm text-muted uppercase tracking-wider mb-2 font-body">{product.category}</p>
            <h1 class="heading-lg mb-4">{product.name}</h1>
            <p class="text-2xl text-accent mb-6 font-body">{formatPrice(product.price)}</p>
            <p class="text-foreground/70 font-body mb-8 leading-relaxed">{product.description}</p>

            <!-- Colors -->
            <div class="mb-6">
              <p class="text-sm font-body font-medium mb-3">Colors</p>
              <div class="flex gap-3">
                {product.colors.map((color) => (
                  <button class="w-8 h-8 border border-border hover:border-foreground transition-colors" title={color}>
                    <span class="sr-only">{color}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Sizes -->
            <div class="mb-8">
              <p class="text-sm font-body font-medium mb-3">Sizes</p>
              <div class="flex gap-3">
                {product.sizes.map((size) => (
                  <button class="px-4 py-2 border border-border text-sm font-body hover:bg-foreground hover:text-background transition-colors">
                    {size}
                  </button>
                ))}
              </div>
            </div>

            <!-- CTA -->
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-accent flex-1 text-center"
              >
                Order via WhatsApp
              </a>
              <a href="/shop" class="btn-secondary flex-1 text-center">
                Continue Shopping
              </a>
            </div>

            <!-- Free Shipping -->
            <p class="mt-6 text-sm text-muted font-body">
              Free shipping on orders over {formatPrice(siteConfig.shipping.freeShippingMinimum)}
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
