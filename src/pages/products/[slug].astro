---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductInfo from '../../components/ProductInfo.astro';
import ProductTabs from '../../components/ProductTabs.astro';
import ProductReviews from '../../components/ProductReviews.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import ProductCardV2 from '../../components/ProductCardV2.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductError from '../../components/ProductError.astro';
import { fetchProductBySlug, fetchProducts } from '../../utils/productApi';

// Get all products for static generation
const { slug } = Astro.params;
const product = await fetchProductBySlug(slug!);

// Handle missing product
if (!product) {
  return Astro.redirect('/404');
}

// Get related products (same category)
const allProducts = await fetchProducts();
const relatedProducts = allProducts
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const title = product.metaTitle || `${product.name} | Shop`;
const description = product.metaDescription || product.shortDescription || product.description;

const productUrl = new URL(`/products/${product.slug}`, Astro.site ?? Astro.url.origin).href;

// JSON-LD is embedded with `<` escaped so a product field can never terminate
// the script element.
const productSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.id,
  image: product.images.map((image) => new URL(image.src, Astro.site ?? Astro.url.origin).href),
  category: product.subcategory ?? product.category,
  brand: { '@type': 'Brand', name: 'Roquace' },
  offers: {
    '@type': 'Offer',
    url: productUrl,
    priceCurrency: 'IDR',
    price: product.price,
    availability: product.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
  aggregateRating: product.reviewCount > 0 && {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
  },
}).replace(/</g, '\\u003c');

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: new URL('/shop', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 3, name: product.name, item: productUrl },
  ],
}).replace(/</g, '\\u003c');
---

<Layout title={title} description={description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={`${productSchema}\n${breadcrumbSchema}`}
  />

  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <div class="container-custom mb-8">
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Shop', href: '/shop' },
          { label: product.category, href: `/shop/${product.category}` },
          { label: product.name },
        ]}
      />
    </div>

    <!-- Product Detail -->
    <section class="section-padding pt-0">
      <div class="container-custom">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-16">
          <!-- Product Gallery -->
          <div>
            <ProductGallery images={product.images} productName={product.name} />
          </div>

          <!-- Product Info -->
          <div>
            <ProductInfo product={product} />
          </div>
        </div>
      </div>
    </section>

    <!-- Product Tabs -->
    <section class="section-padding pt-0">
      <div class="container-custom">
        <ProductTabs 
          description={product.description}
          material={product.material}
          care={product.care}
          fit={product.fit}
        />
      </div>
    </section>

    <ProductReviews productId={product.id} />

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="section-padding pt-0">
        <div class="container-custom">
          <div class="mb-12">
            <h2 class="text-2xl md:text-3xl font-heading">You May Also Like</h2>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
            {relatedProducts.map((p, index) => (
              <ProductCardV2 product={p} index={index} showQuickAdd={false} />
            ))}
          </div>
        </div>
      </section>
    )}

    <RecentlyViewed currentSlug={product.slug} />
  </main>

  <Footer />
</Layout>

<!-- Size Guide Modal -->
<div id="size-guide-modal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="size-guide-backdrop"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl bg-background p-8 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-2xl font-heading">Size Guide</h3>
      <button id="close-size-guide" class="p-2 hover:bg-foreground/5 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="mb-6">
      <h4 class="text-sm tracking-wider uppercase font-body text-foreground/60 mb-4">How to Measure</h4>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <p class="text-sm font-body text-foreground/70 mb-2"><strong>Chest:</strong> Measure around the fullest part of your chest, keeping the tape horizontal.</p>
          <p class="text-sm font-body text-foreground/70"><strong>Length:</strong> Measure from the highest point of the shoulder down to the hem.</p>
        </div>
        <div class="bg-foreground/5 p-4 text-sm font-body text-foreground/70">
          <p>All measurements are in centimeters (cm).</p>
          <p class="mt-2">For the best fit, compare with a similar item you already own.</p>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm font-body">
        <thead>
          <tr class="border-b-2 border-foreground">
            <th class="py-3 px-4 text-left font-medium">Size</th>
            <th class="py-3 px-4 text-center font-medium">Chest (cm)</th>
            <th class="py-3 px-4 text-center font-medium">Length (cm)</th>
            <th class="py-3 px-4 text-center font-medium">Waist (cm)</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border">
            <td class="py-3 px-4 font-medium">XS</td>
            <td class="py-3 px-4 text-center">88</td>
            <td class="py-3 px-4 text-center">65</td>
            <td class="py-3 px-4 text-center">70</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4 font-medium">S</td>
            <td class="py-3 px-4 text-center">92</td>
            <td class="py-3 px-4 text-center">67</td>
            <td class="py-3 px-4 text-center">74</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4 font-medium">M</td>
            <td class="py-3 px-4 text-center">96</td>
            <td class="py-3 px-4 text-center">69</td>
            <td class="py-3 px-4 text-center">78</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4 font-medium">L</td>
            <td class="py-3 px-4 text-center">100</td>
            <td class="py-3 px-4 text-center">71</td>
            <td class="py-3 px-4 text-center">82</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-medium">XL</td>
            <td class="py-3 px-4 text-center">104</td>
            <td class="py-3 px-4 text-center">73</td>
            <td class="py-3 px-4 text-center">86</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Size guide modal
  const sizeGuideModal = document.getElementById('size-guide-modal');
  const sizeGuideBtn = document.getElementById('size-guide-btn');
  const closeSizeGuide = document.getElementById('close-size-guide');
  const sizeGuideBackdrop = document.getElementById('size-guide-backdrop');

  function openSizeGuide() {
    sizeGuideModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeSizeGuideModal() {
    sizeGuideModal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  sizeGuideBtn?.addEventListener('click', openSizeGuide);
  closeSizeGuide?.addEventListener('click', closeSizeGuideModal);
  sizeGuideBackdrop?.addEventListener('click', closeSizeGuideModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sizeGuideModal?.classList.contains('hidden')) {
      closeSizeGuideModal();
    }
  });

  // Save to recently viewed
  const productId = window.location.pathname.split('/').pop();
  if (productId) {
    try {
      let recentlyViewed = JSON.parse(localStorage.getItem('roquace-recently-viewed') || '[]');
      recentlyViewed = recentlyViewed.filter((id: string) => id !== productId);
      recentlyViewed.unshift(productId);
      recentlyViewed = recentlyViewed.slice(0, 8); // Keep last 8
      localStorage.setItem('roquace-recently-viewed', JSON.stringify(recentlyViewed));
    } catch (e) {
      // Handle error silently
    }
  }
</script>
