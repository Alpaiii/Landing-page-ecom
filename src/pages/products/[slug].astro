---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, getProductBySlug, getRelatedProducts, type Product } from '../../data/products';
import { siteConfig } from '../../config/site';
import { formatPrice, calculateDiscountPercentage } from '../../utils/currency';
import { generateProductInquiryMessage, generateWhatsAppUrl } from '../../utils/whatsapp';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const discount = product.compareAtPrice ? calculateDiscountPercentage(product.compareAtPrice, product.price) : 0;
const relatedProducts = getRelatedProducts(product, 4);
---

<Layout title={product.name} description={product.description}>
  <AnnouncementBar />
  <Navbar />

  <main class="pt-32 md:pt-36">
    <!-- Breadcrumb -->
    <div class="container-custom mb-8">
      <nav class="flex items-center gap-2 text-sm font-body text-muted">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <a href="/shop" class="hover:text-foreground transition-colors">Shop</a>
        <span>/</span>
        <span class="text-foreground">{product.name}</span>
      </nav>
    </div>

    <section class="section-padding pt-0">
      <div class="container-custom">
        <div class="grid md:grid-cols-2 gap-8 md:gap-16">
          <!-- Product Gallery -->
          <div class="space-y-4">
            <!-- Main Image -->
            <div class="aspect-[3/4] overflow-hidden bg-secondary/30">
              <img
                id="main-image"
                src={product.thumbnail}
                alt={product.name}
                class="w-full h-full object-cover"
              />
            </div>
            
            <!-- Thumbnails -->
            {product.images.length > 1 && (
              <div class="flex gap-3 overflow-x-auto scrollbar-hide">
                {product.images.map((image, index) => (
                  <button
                    class="thumbnail-btn w-20 h-24 shrink-0 overflow-hidden border-2 border-transparent hover:border-foreground transition-colors data-[active=true]:border-foreground"
                    data-src={image.src}
                    data-active={index === 0}
                  >
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="w-full h-full object-cover"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- Product Info -->
          <div class="flex flex-col">
            <!-- Badge -->
            {product.badge && (
              <span class="inline-block text-xs tracking-wider uppercase text-accent mb-4 font-body">
                {product.badge}
                {product.badge === 'Sale' && discount > 0 && ` - Save ${discount}%`}
              </span>
            )}
            
            <!-- Category -->
            <p class="text-sm text-muted uppercase tracking-wider mb-2 font-body">{product.subcategory || product.category}</p>
            
            <!-- Title -->
            <h1 class="heading-lg mb-4">{product.name}</h1>
            
            <!-- Rating -->
            {product.rating > 0 && (
              <div class="flex items-center gap-3 mb-4">
                <div class="flex items-center gap-0.5">
                  {[...Array(5)].map((_, i) => (
                    <svg
                      class={`w-4 h-4 ${i < Math.floor(product.rating) ? 'text-accent' : 'text-foreground/20'}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="text-sm text-muted font-body">{product.rating} ({product.reviewCount} reviews)</span>
              </div>
            )}
            
            <!-- Price -->
            <div class="flex items-center gap-3 mb-6">
              <p class="text-2xl text-accent font-body font-medium">{formatPrice(product.price)}</p>
              {product.compareAtPrice && (
                <p class="text-lg text-muted font-body line-through">{formatPrice(product.compareAtPrice)}</p>
              )}
            </div>
            
            <!-- Short Description -->
            <p class="text-foreground/70 font-body mb-8 leading-relaxed">
              {product.shortDescription || product.description}
            </p>

            <!-- Color Selection -->
            <div class="mb-6">
              <div class="flex items-center justify-between mb-3">
                <p class="text-sm font-body font-medium">Color</p>
                <p id="selected-color" class="text-sm text-muted font-body">Select a color</p>
              </div>
              <div class="flex gap-3">
                {product.colors.map((color, index) => (
                  <button
                    class="color-btn w-10 h-10 rounded-full border-2 border-transparent hover:border-foreground transition-colors data-[active=true]:border-foreground"
                    style={`background-color: ${color.hex}`}
                    data-color={color.name}
                    data-active={index === 0}
                    title={color.name}
                  >
                    <span class="sr-only">{color.name}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Size Selection -->
            <div class="mb-6">
              <div class="flex items-center justify-between mb-3">
                <p class="text-sm font-body font-medium">Size</p>
                <button id="size-guide-btn" class="text-sm text-accent font-body hover:underline">
                  Size Guide
                </button>
              </div>
              <div class="flex flex-wrap gap-3">
                {product.sizes.map((size, index) => (
                  <button
                    class="size-btn px-5 py-3 border text-sm font-body transition-colors data-[available=false]:opacity-40 data-[available=false]:cursor-not-allowed hover:border-foreground data-[active=true]:bg-foreground data-[active=true]:text-background"
                    data-size={size.name}
                    data-available={size.available}
                    data-active={size.available && index === 0}
                    disabled={!size.available}
                  >
                    {size.name}
                    {!size.available && <span class="sr-only">(Sold Out)</span>}
                  </button>
                ))}
              </div>
            </div>

            <!-- Quantity -->
            <div class="mb-8">
              <p class="text-sm font-body font-medium mb-3">Quantity</p>
              <div class="flex items-center gap-4">
                <div class="flex items-center border border-border">
                  <button id="qty-decrease" class="px-4 py-3 text-lg hover:bg-secondary/30 transition-colors" aria-label="Decrease quantity">−</button>
                  <input
                    type="number"
                    id="qty-input"
                    value="1"
                    min="1"
                    max={product.stockCount || 99}
                    class="w-16 text-center py-3 border-x border-border font-body focus:outline-none"
                  />
                  <button id="qty-increase" class="px-4 py-3 text-lg hover:bg-secondary/30 transition-colors" aria-label="Increase quantity">+</button>
                </div>
                {product.inStock && product.stockCount && (
                  <p class="text-sm text-muted font-body">{product.stockCount} in stock</p>
                )}
              </div>
            </div>

            <!-- Add to Cart & WhatsApp -->
            <div class="flex flex-col sm:flex-row gap-4 mb-6">
              <button
                id="add-to-cart-btn"
                class="btn-primary flex-1 flex items-center justify-center gap-2"
                disabled={!product.inStock}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                {product.inStock ? 'Add to Cart' : 'Sold Out'}
              </button>
              <a
                id="whatsapp-btn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-accent flex-1 text-center"
              >
                Order via WhatsApp
              </a>
            </div>

            <!-- Wishlist -->
            <button
              id="wishlist-btn"
              class="flex items-center gap-2 text-sm font-body text-muted hover:text-foreground transition-colors mb-8"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              Add to Wishlist
            </button>

            <!-- Product Details Accordion -->
            <div class="border-t border-border pt-8 space-y-4">
              <!-- Description -->
              <details class="group" open>
                <summary class="flex items-center justify-between cursor-pointer py-3 font-body font-medium">
                  Description
                  <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="text-foreground/70 font-body leading-relaxed pb-4">{product.description}</p>
              </details>

              <!-- Material & Care -->
              {(product.material || product.care) && (
                <details class="group border-t border-border">
                  <summary class="flex items-center justify-between cursor-pointer py-3 font-body font-medium">
                    Material & Care
                    <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="pb-4">
                    {product.material && (
                      <p class="text-foreground/70 font-body mb-2"><strong>Material:</strong> {product.material}</p>
                    )}
                    {product.care && (
                      <ul class="text-foreground/70 font-body space-y-1">
                        {product.care.map((instruction) => (
                          <li>• {instruction}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </details>
              )}

              <!-- Shipping -->
              <details class="group border-t border-border">
                <summary class="flex items-center justify-between cursor-pointer py-3 font-body font-medium">
                  Shipping
                  <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="pb-4 text-foreground/70 font-body space-y-2">
                  <p>• Free shipping on orders over {formatPrice(siteConfig.shipping.freeShippingMinimum)}</p>
                  <p>• Estimated delivery: {siteConfig.shipping.estimatedDays}</p>
                  <p>• We ship to all regions in Indonesia</p>
                </div>
              </details>

              <!-- Returns -->
              <details class="group border-t border-border">
                <summary class="flex items-center justify-between cursor-pointer py-3 font-body font-medium">
                  Returns
                  <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="pb-4 text-foreground/70 font-body space-y-2">
                  <p>• Returns accepted within 7 days of delivery</p>
                  <p>• Items must be unworn with original tags</p>
                  <p>• Sale items are final sale</p>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="section-padding pt-0">
        <div class="container-custom">
          <div class="text-center mb-12">
            <h2 class="heading-md">You May Also Like</h2>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
            {relatedProducts.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<!-- Size Guide Modal -->
<div id="size-guide-modal" class="fixed inset-0 z-[70] hidden">
  <div class="absolute inset-0 bg-foreground/50 backdrop-blur-sm" id="size-guide-overlay"></div>
  <div class="absolute inset-4 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:max-w-lg md:w-full bg-background p-8 overflow-auto max-h-full">
    <div class="flex items-center justify-between mb-6">
      <h3 class="heading-sm">Size Guide</h3>
      <button id="size-guide-close" class="p-2" aria-label="Close">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm font-body">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 px-4 text-left">Size</th>
            <th class="py-3 px-4 text-center">Chest (cm)</th>
            <th class="py-3 px-4 text-center">Length (cm)</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border">
            <td class="py-3 px-4">S</td>
            <td class="py-3 px-4 text-center">52</td>
            <td class="py-3 px-4 text-center">68</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4">M</td>
            <td class="py-3 px-4 text-center">55</td>
            <td class="py-3 px-4 text-center">70</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4">L</td>
            <td class="py-3 px-4 text-center">58</td>
            <td class="py-3 px-4 text-center">72</td>
          </tr>
          <tr>
            <td class="py-3 px-4">XL</td>
            <td class="py-3 px-4 text-center">61</td>
            <td class="py-3 px-4 text-center">74</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-sm text-muted font-body">
      Measurements are approximate and may vary slightly. For the best fit, compare with a similar item you already own.
    </p>
  </div>
</div>

<script define:vars={{ product, siteConfig }}>
  // Product data for client-side
  const productData = product;
  const whatsappNumber = siteConfig.contact.whatsapp;

  // State
  let selectedColor = productData.colors[0]?.name || '';
  let selectedSize = productData.sizes.find(s => s.available)?.name || '';
  let quantity = 1;

  // Elements
  const mainImage = document.getElementById('main-image');
  const thumbnails = document.querySelectorAll('.thumbnail-btn');
  const colorBtns = document.querySelectorAll('.color-btn');
  const sizeBtns = document.querySelectorAll('.size-btn');
  const selectedColorText = document.getElementById('selected-color');
  const qtyInput = document.getElementById('qty-input');
  const qtyDecrease = document.getElementById('qty-decrease');
  const qtyIncrease = document.getElementById('qty-increase');
  const addToCartBtn = document.getElementById('add-to-cart-btn');
  const whatsappBtn = document.getElementById('whatsapp-btn');
  const wishlistBtn = document.getElementById('wishlist-btn');
  const sizeGuideBtn = document.getElementById('size-guide-btn');
  const sizeGuideModal = document.getElementById('size-guide-modal');
  const sizeGuideClose = document.getElementById('size-guide-close');
  const sizeGuideOverlay = document.getElementById('size-guide-overlay');

  // Thumbnail click
  thumbnails.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      mainImage.src = src;
      thumbnails.forEach(b => b.dataset.active = 'false');
      btn.dataset.active = 'true';
    });
  });

  // Color selection
  colorBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectedColor = btn.dataset.color;
      selectedColorText.textContent = selectedColor;
      colorBtns.forEach(b => b.dataset.active = 'false');
      btn.dataset.active = 'true';
      updateWhatsAppLink();
    });
  });

  // Size selection
  sizeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.available === 'false') return;
      selectedSize = btn.dataset.size;
      sizeBtns.forEach(b => b.dataset.active = 'false');
      btn.dataset.active = 'true';
      updateWhatsAppLink();
    });
  });

  // Quantity
  qtyDecrease?.addEventListener('click', () => {
    if (quantity > 1) {
      quantity--;
      qtyInput.value = quantity;
      updateWhatsAppLink();
    }
  });

  qtyIncrease?.addEventListener('click', () => {
    const max = parseInt(qtyInput.max) || 99;
    if (quantity < max) {
      quantity++;
      qtyInput.value = quantity;
      updateWhatsAppLink();
    }
  });

  qtyInput?.addEventListener('change', (e) => {
    const val = parseInt(e.target.value) || 1;
    const max = parseInt(qtyInput.max) || 99;
    quantity = Math.max(1, Math.min(val, max));
    qtyInput.value = quantity;
    updateWhatsAppLink();
  });

  // WhatsApp link
  function updateWhatsAppLink() {
    const message = `Hi, I am interested in:\n\nProduct: ${productData.name}\nColor: ${selectedColor}\nSize: ${selectedSize}\nQuantity: ${quantity}\nPrice: ${new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(productData.price)}\n\nIs this product available?`;
    whatsappBtn.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
  }

  // Initial WhatsApp link
  updateWhatsAppLink();

  // Add to cart
  addToCartBtn?.addEventListener('click', () => {
    if (!selectedColor || !selectedSize) {
      alert('Please select color and size');
      return;
    }

    // Get cart from localStorage
    const cart = JSON.parse(localStorage.getItem('roquace_cart') || '[]');
    
    // Check if item already exists
    const existingIndex = cart.findIndex(
      item => item.productId === productData.id && item.color === selectedColor && item.size === selectedSize
    );

    if (existingIndex > -1) {
      cart[existingIndex].quantity += quantity;
    } else {
      cart.push({
        productId: productData.id,
        product: productData,
        color: selectedColor,
        size: selectedSize,
        quantity,
        price: productData.price
      });
    }

    localStorage.setItem('roquace_cart', JSON.stringify(cart));
    
    // Dispatch event
    window.dispatchEvent(new CustomEvent('cart-updated'));
    
    // Visual feedback
    addToCartBtn.textContent = 'Added!';
    setTimeout(() => {
      addToCartBtn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg> Add to Cart`;
    }, 1500);
  });

  // Wishlist
  let isInWishlist = false;
  wishlistBtn?.addEventListener('click', () => {
    isInWishlist = !isInWishlist;
    const svg = wishlistBtn.querySelector('svg');
    if (isInWishlist) {
      svg.setAttribute('fill', 'currentColor');
      wishlistBtn.classList.add('text-accent');
    } else {
      svg.setAttribute('fill', 'none');
      wishlistBtn.classList.remove('text-accent');
    }
  });

  // Size guide modal
  sizeGuideBtn?.addEventListener('click', () => {
    sizeGuideModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  });

  function closeSizeGuide() {
    sizeGuideModal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  sizeGuideClose?.addEventListener('click', closeSizeGuide);
  sizeGuideOverlay?.addEventListener('click', closeSizeGuide);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sizeGuideModal?.classList.contains('hidden')) {
      closeSizeGuide();
    }
  });
</script>
