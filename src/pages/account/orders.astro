---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'My Orders';
const description = 'View your order history';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-5xl">
        <!-- Header -->
        <div class="mb-12">
          <div class="flex items-center gap-2 text-sm font-body text-foreground/60 mb-4">
            <a href="/account" class="hover:text-foreground">Account</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-foreground">Orders</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-heading mb-2">My Orders</h1>
          <p id="orders-count" class="text-foreground/70 font-body">0 orders</p>
        </div>

        <!-- Orders List -->
        <div id="orders-list" class="space-y-6">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Empty State -->
        <div id="orders-empty" class="hidden text-center py-16">
          <svg class="w-20 h-20 mx-auto mb-6 text-foreground/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <h2 class="text-2xl font-heading mb-2">No orders yet</h2>
          <p class="text-foreground/60 font-body mb-8">Start shopping to see your orders here</p>
          <a href="/shop" class="btn-secondary inline-block">
            Start Shopping
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function formatPrice(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(price);
  }

  function formatDate(dateString: string): string {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    });
  }

  function getStatusColor(status: string): string {
    const colors: Record<string, string> = {
      'pending': 'bg-yellow-500/10 text-yellow-600',
      'processing': 'bg-blue-500/10 text-blue-500',
      'shipped': 'bg-purple-500/10 text-purple-500',
      'delivered': 'bg-green-500/10 text-green-500',
      'cancelled': 'bg-red-500/10 text-red-500',
    };
    return colors[status] || 'bg-foreground/10 text-foreground';
  }

  const API_URL = 'http://localhost:4000';

  async function loadOrders() {
    try {
      // Check authentication
      const token = localStorage.getItem('customer_token');
      
      if (!token) {
        window.location.href = '/login?return=/account/orders';
        return;
      }

      // Fetch orders from API
      const response = await fetch(`${API_URL}/api/customers/orders`, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (!response.ok) {
        throw new Error('Failed to fetch orders');
      }

      const result = await response.json();
      const orders = result.data || [];

      const ordersListEl = document.getElementById('orders-list');
      const ordersEmptyEl = document.getElementById('orders-empty');
      const ordersCountEl = document.getElementById('orders-count');

      if (ordersCountEl) {
        ordersCountEl.textContent = `${orders.length} order${orders.length !== 1 ? 's' : ''}`;
      }

      if (orders.length === 0) {
        ordersListEl?.classList.add('hidden');
        ordersEmptyEl?.classList.remove('hidden');
      } else {
        ordersListEl?.classList.remove('hidden');
        ordersEmptyEl?.classList.add('hidden');

        if (ordersListEl) {
          ordersListEl.innerHTML = orders.map((order: any) => `
            <div class="border border-border p-6 hover:border-foreground/20 transition-colors">
              <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                <div>
                  <p class="font-body font-medium mb-1">Order #${order.id.substring(0, 8)}</p>
                  <p class="text-sm text-foreground/60 font-body">Placed on ${formatDate(order.created_at)}</p>
                </div>
                <div class="text-right">
                  <p class="font-body font-medium mb-1">${formatPrice(order.total_amount)}</p>
                  <span class="inline-block text-xs px-3 py-1 rounded-full capitalize ${getStatusColor(order.status)}">
                    ${order.status}
                  </span>
                </div>
              </div>

              <div class="space-y-3 mb-4">
                ${order.items.slice(0, 2).map((item: any) => `
                  <div class="flex items-center gap-4">
                    <img src="${item.image || '/images/placeholder.jpg'}" alt="${item.name}" class="w-16 h-16 object-cover bg-foreground/5" />
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-body truncate">${item.name}</p>
                      <p class="text-xs text-foreground/60 font-body">Qty: ${item.quantity}</p>
                    </div>
                    <p class="text-sm font-body">${formatPrice(item.price * item.quantity)}</p>
                  </div>
                `).join('')}
                ${order.items.length > 2 ? `
                  <p class="text-xs text-foreground/60 font-body">+ ${order.items.length - 2} more item${order.items.length - 2 > 1 ? 's' : ''}</p>
                ` : ''}
              </div>

              <div class="flex gap-3">
                <a href="/order/success?orderId=${order.id}" class="text-sm tracking-wider uppercase font-body underline hover:no-underline">
                  View Details
                </a>
                <a href="/track-order?orderId=${order.id}" class="text-sm tracking-wider uppercase font-body underline hover:no-underline">
                  Track Order
                </a>
              </div>
            </div>
          `).join('');
        }
      }

    } catch (error) {
      console.error('Load orders error:', error);
      localStorage.removeItem('customer_token');
      window.location.href = '/login?return=/account/orders';
    }
  }

  // Load orders on page load
  loadOrders();
      ordersListEl?.classList.add('hidden');
      ordersEmptyEl?.classList.remove('hidden');
    } else {
      ordersListEl?.classList.remove('hidden');
      ordersEmptyEl?.classList.add('hidden');

      if (ordersListEl) {
        ordersListEl.innerHTML = orderHistory.map((order: any) => `
          <div class="border border-border p-6 hover:border-foreground transition-colors">
            <!-- Order Header -->
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6 pb-6 border-b border-border">
              <div>
                <h3 class="text-lg font-heading mb-2">Order #${order.orderId}</h3>
                <p class="text-sm text-foreground/60 font-body">${formatDate(order.date)}</p>
              </div>
              <div class="flex items-center gap-4">
                <span class="px-3 py-1 text-xs font-body rounded ${getStatusColor(order.status || 'Processing')}">
                  ${order.status || 'Processing'}
                </span>
                <a href="/track-order?orderId=${order.orderId}" class="text-sm font-body underline hover:no-underline">
                  Track Order
                </a>
              </div>
            </div>

            <!-- Order Items -->
            <div class="space-y-4 mb-6">
              ${order.items.map((item: any) => `
                <div class="flex gap-4">
                  <div class="w-20 h-24 flex-shrink-0 bg-foreground/5">
                    <img src="${item.product.thumbnail}" alt="${item.product.name}" class="w-full h-full object-cover" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <a href="/products/${item.product.slug}" class="text-sm font-body hover:text-accent transition-colors block mb-1">
                      ${item.product.name}
                    </a>
                    <p class="text-xs text-foreground/60 font-body">Quantity: ${item.quantity}</p>
                    <p class="text-sm font-body font-medium mt-2">${formatPrice(item.price * item.quantity)}</p>
                  </div>
                </div>
              `).join('')}
            </div>

            <!-- Order Total -->
            <div class="flex items-center justify-between pt-6 border-t border-border">
              <span class="text-sm font-body text-foreground/70">Total</span>
              <span class="text-lg font-body font-medium">${formatPrice(order.total)}</span>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-3 mt-6">
              <a
                href="/track-order?orderId=${order.orderId}"
                class="flex-1 py-3 text-center border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
              >
                Track Order
              </a>
              <button
                class="reorder-btn flex-1 py-3 text-center bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
                data-order-id="${order.orderId}"
              >
                Order Again
              </button>
            </div>
          </div>
        `).join('');

        // Attach reorder button handlers
        document.querySelectorAll('.reorder-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const orderId = (btn as HTMLElement).dataset.orderId;
            const order = orderHistory.find((o: any) => o.orderId === orderId);
            
            if (order) {
              // Add all items to cart
              const currentCart = JSON.parse(localStorage.getItem('roquace_cart') || '[]');
              const newCart = [...currentCart, ...order.items];
              localStorage.setItem('roquace_cart', JSON.stringify(newCart));
              window.dispatchEvent(new CustomEvent('cart-updated'));
              
              // Redirect to cart
              window.location.href = '/cart';
            }
          });
        });
      }
    }

  } catch (e) {
    console.error('Session error:', e);
    window.location.href = '/login?return=/account/orders';
  }
</script>
