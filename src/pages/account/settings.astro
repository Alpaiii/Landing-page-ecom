---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'Account Settings';
const description = 'Manage your account settings';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-3xl">
        <!-- Header -->
        <div class="mb-12">
          <div class="flex items-center gap-2 text-sm font-body text-foreground/60 mb-4">
            <a href="/account" class="hover:text-foreground">Account</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-foreground">Settings</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-heading mb-2">Account Settings</h1>
          <p class="text-foreground/70 font-body">Manage your profile and preferences</p>
        </div>

        <!-- Profile Information -->
        <div class="border border-border p-6 mb-6">
          <h2 class="text-xl tracking-wider uppercase font-body mb-6">Profile Information</h2>
          
          <form id="profile-form" class="space-y-4">
            <div>
              <label for="profile-name" class="block text-sm tracking-wider uppercase font-body mb-2">Full Name *</label>
              <input
                type="text"
                id="profile-name"
                required
                class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              />
            </div>

            <div>
              <label for="profile-email" class="block text-sm tracking-wider uppercase font-body mb-2">Email *</label>
              <input
                type="email"
                id="profile-email"
                required
                class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              />
            </div>

            <div>
              <label for="profile-phone" class="block text-sm tracking-wider uppercase font-body mb-2">Phone</label>
              <input
                type="tel"
                id="profile-phone"
                class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                placeholder="+62 812 3456 7890"
              />
            </div>

            <div id="profile-message" class="hidden p-4 text-sm font-body"></div>

            <button
              type="submit"
              id="save-profile"
              class="py-3 px-6 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
            >
              Save Changes
            </button>
          </form>
        </div>

        <!-- Change Password -->
        <div class="border border-border p-6 mb-6">
          <h2 class="text-xl tracking-wider uppercase font-body mb-6">Change Password</h2>
          
          <form id="password-form" class="space-y-4">
            <div>
              <label for="current-password" class="block text-sm tracking-wider uppercase font-body mb-2">Current Password *</label>
              <input
                type="password"
                id="current-password"
                required
                class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              />
            </div>

            <div>
              <label for="new-password" class="block text-sm tracking-wider uppercase font-body mb-2">New Password *</label>
              <input
                type="password"
                id="new-password"
                required
                minlength="6"
                class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              />
              <p class="text-xs text-foreground/60 font-body mt-2">Must be at least 6 characters</p>
            </div>

            <div>
              <label for="confirm-new-password" class="block text-sm tracking-wider uppercase font-body mb-2">Confirm New Password *</label>
              <input
                type="password"
                id="confirm-new-password"
                required
                minlength="6"
                class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              />
            </div>

            <div id="password-message" class="hidden p-4 text-sm font-body"></div>

            <button
              type="submit"
              id="change-password"
              class="py-3 px-6 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
            >
              Update Password
            </button>
          </form>
        </div>

        <!-- Email Preferences -->
        <div class="border border-border p-6 mb-6">
          <h2 class="text-xl tracking-wider uppercase font-body mb-6">Email Preferences</h2>
          
          <div class="space-y-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="email-newsletter" class="w-4 h-4 mt-1 border-border" />
              <div>
                <p class="text-sm font-body font-medium mb-1">Newsletter</p>
                <p class="text-xs text-foreground/60 font-body">Receive updates about new products and exclusive offers</p>
              </div>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="email-orders" class="w-4 h-4 mt-1 border-border" checked />
              <div>
                <p class="text-sm font-body font-medium mb-1">Order Updates</p>
                <p class="text-xs text-foreground/60 font-body">Receive notifications about your order status</p>
              </div>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="email-promotions" class="w-4 h-4 mt-1 border-border" />
              <div>
                <p class="text-sm font-body font-medium mb-1">Promotions</p>
                <p class="text-xs text-foreground/60 font-body">Get notified about special sales and promotions</p>
              </div>
            </label>

            <button
              id="save-preferences"
              class="py-3 px-6 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
            >
              Save Preferences
            </button>
          </div>
        </div>

        <!-- Delete Account -->
        <div class="border border-red-500/20 p-6">
          <h2 class="text-xl tracking-wider uppercase font-body mb-4 text-red-500">Danger Zone</h2>
          <p class="text-sm text-foreground/70 font-body mb-6">
            Once you delete your account, there is no going back. This action cannot be undone.
          </p>
          <button
            id="delete-account"
            class="py-3 px-6 border border-red-500 text-red-500 text-sm tracking-wider uppercase font-body hover:bg-red-500 hover:text-white transition-colors"
          >
            Delete Account
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const API_URL = 'http://localhost:4000';

  function showMessage(elementId: string, message: string, type: 'success' | 'error') {
    const el = document.getElementById(elementId);
    if (!el) return;
    
    el.textContent = message;
    el.className = `p-4 text-sm font-body ${
      type === 'success' 
        ? 'bg-accent/10 border border-accent/20 text-accent' 
        : 'bg-red-500/10 border border-red-500/20 text-red-500'
    }`;
    el.classList.remove('hidden');
    
    setTimeout(() => {
      el.classList.add('hidden');
    }, 3000);
  }

  async function checkAuth() {
    const token = localStorage.getItem('customer_token');
    if (!token) {
      window.location.href = '/login?return=/account/settings';
      return null;
    }
    return token;
  }

  async function loadProfile() {
    const token = await checkAuth();
    if (!token) return;

    try {
      const response = await fetch(`${API_URL}/api/customers/customer-verify`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!response.ok) {
        throw new Error('Invalid token');
      }

      const result = await response.json();
      const customer = result.customer;

      // Populate form
      const profileName = document.getElementById('profile-name') as HTMLInputElement;
      const profileEmail = document.getElementById('profile-email') as HTMLInputElement;
      const profilePhone = document.getElementById('profile-phone') as HTMLInputElement;
      const emailNewsletter = document.getElementById('email-newsletter') as HTMLInputElement;

      if (profileName) profileName.value = customer.name || '';
      if (profileEmail) profileEmail.value = customer.email || '';
      if (profilePhone) profilePhone.value = customer.phone || '';
      // Newsletter preference - store in localStorage for now
      if (emailNewsletter) emailNewsletter.checked = localStorage.getItem('email_newsletter') === 'true';
    } catch (e) {
      console.error('Load profile error:', e);
      localStorage.removeItem('customer_token');
      window.location.href = '/login?return=/account/settings';
    }
  }

  // Profile form
  const profileForm = document.getElementById('profile-form');
  const profileName = document.getElementById('profile-name') as HTMLInputElement;
  const profileEmail = document.getElementById('profile-email') as HTMLInputElement;
  const profilePhone = document.getElementById('profile-phone') as HTMLInputElement;

  profileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const token = await checkAuth();
    if (!token) return;

    try {
      const response = await fetch(`${API_URL}/api/customers/profile`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          name: profileName.value,
          phone: profilePhone.value
        })
      });

      if (!response.ok) {
        throw new Error('Failed to update profile');
      }

      showMessage('profile-message', '✓ Profile updated successfully', 'success');
    } catch (e) {
      showMessage('profile-message', '✗ Failed to update profile', 'error');
    }
  });

  // Password form
  const passwordForm = document.getElementById('password-form');
  const currentPassword = document.getElementById('current-password') as HTMLInputElement;
  const newPassword = document.getElementById('new-password') as HTMLInputElement;
  const confirmNewPassword = document.getElementById('confirm-new-password') as HTMLInputElement;

  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (newPassword.value !== confirmNewPassword.value) {
      showMessage('password-message', '✗ Passwords do not match', 'error');
      return;
    }

    if (newPassword.value.length < 6) {
      showMessage('password-message', '✗ Password must be at least 6 characters', 'error');
      return;
    }

    const token = await checkAuth();
    if (!token) return;

    try {
      const response = await fetch(`${API_URL}/api/customers/password`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          current_password: currentPassword.value,
          new_password: newPassword.value
        })
      });

      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error || 'Failed to change password');
      }

      passwordForm.reset();
      showMessage('password-message', '✓ Password updated successfully', 'success');
    } catch (e: any) {
      showMessage('password-message', `✗ ${e.message || 'Failed to change password'}`, 'error');
    }
  });

  // Email preferences (store in localStorage for now)
  const savePreferences = document.getElementById('save-preferences');
  const emailNewsletter = document.getElementById('email-newsletter') as HTMLInputElement;
  const emailOrders = document.getElementById('email-orders') as HTMLInputElement;
  const emailPromotions = document.getElementById('email-promotions') as HTMLInputElement;

  savePreferences?.addEventListener('click', () => {
    localStorage.setItem('email_newsletter', String(emailNewsletter.checked));
    localStorage.setItem('email_orders', String(emailOrders.checked));
    localStorage.setItem('email_promotions', String(emailPromotions.checked));

    // Show feedback
    const originalText = savePreferences.textContent;
    savePreferences.textContent = '✓ Saved';
    setTimeout(() => {
      savePreferences.textContent = originalText;
    }, 2000);
  });

  // Delete account
  const deleteAccount = document.getElementById('delete-account');

  deleteAccount?.addEventListener('click', () => {
    if (confirm('Are you absolutely sure? This action cannot be undone.\n\nType "DELETE" to confirm.')) {
      const confirmation = prompt('Type "DELETE" to confirm account deletion:');
      if (confirmation === 'DELETE') {
        // Clear all data
        localStorage.removeItem('customer_token');
        localStorage.removeItem('roquace_session');
        localStorage.removeItem('roquace_cart');
        localStorage.removeItem('roquace-wishlist');
        localStorage.removeItem('roquace_order_history');
        localStorage.removeItem('roquace_addresses');
        localStorage.removeItem('roquace-recently-viewed');
        
        alert('Your account has been deleted.');
        window.location.href = '/';
      }
    }
  });

  // Initial load
  loadProfile();
</script>
