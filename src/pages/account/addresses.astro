---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'My Addresses';
const description = 'Manage your saved addresses';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-5xl">
        <!-- Header -->
        <div class="mb-12">
          <div class="flex items-center gap-2 text-sm font-body text-foreground/60 mb-4">
            <a href="/account" class="hover:text-foreground">Account</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-foreground">Addresses</span>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-3xl md:text-4xl font-heading mb-2">My Addresses</h1>
              <p class="text-foreground/70 font-body">Manage your saved shipping addresses</p>
            </div>
            <button
              id="add-address-btn"
              class="px-6 py-3 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
            >
              Add Address
            </button>
          </div>
        </div>

        <!-- Addresses Grid -->
        <div id="addresses-grid" class="grid md:grid-cols-2 gap-6">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Empty State -->
        <div id="addresses-empty" class="hidden text-center py-16">
          <svg class="w-20 h-20 mx-auto mb-6 text-foreground/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h2 class="text-2xl font-heading mb-2">No saved addresses</h2>
          <p class="text-foreground/60 font-body mb-8">Add an address for faster checkout</p>
          <button
            id="add-first-address-btn"
            class="btn-secondary inline-block"
          >
            Add Address
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Add/Edit Address Modal -->
  <div id="address-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="address-modal-backdrop"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl bg-background p-8 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 id="modal-title" class="text-2xl font-heading">Add Address</h2>
        <button id="close-modal" class="p-2 hover:bg-foreground/5 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="address-form" class="space-y-4">
        <input type="hidden" id="address-id" />

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="address-name" class="block text-sm tracking-wider uppercase font-body mb-2">Label *</label>
            <input
              type="text"
              id="address-name"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="Home, Office, etc."
            />
          </div>

          <div>
            <label for="address-phone" class="block text-sm tracking-wider uppercase font-body mb-2">Phone *</label>
            <input
              type="tel"
              id="address-phone"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="+62 812 3456 7890"
            />
          </div>
        </div>

        <div>
          <label for="address-full-name" class="block text-sm tracking-wider uppercase font-body mb-2">Full Name *</label>
          <input
            type="text"
            id="address-full-name"
            required
            class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
            placeholder="John Doe"
          />
        </div>

        <div>
          <label for="address-street" class="block text-sm tracking-wider uppercase font-body mb-2">Street Address *</label>
          <input
            type="text"
            id="address-street"
            required
            class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
            placeholder="123 Main Street"
          />
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="address-city" class="block text-sm tracking-wider uppercase font-body mb-2">City *</label>
            <input
              type="text"
              id="address-city"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="Jakarta"
            />
          </div>

          <div>
            <label for="address-province" class="block text-sm tracking-wider uppercase font-body mb-2">Province *</label>
            <input
              type="text"
              id="address-province"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="DKI Jakarta"
            />
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="address-postal" class="block text-sm tracking-wider uppercase font-body mb-2">Postal Code *</label>
            <input
              type="text"
              id="address-postal"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="12345"
            />
          </div>

          <div>
            <label for="address-country" class="block text-sm tracking-wider uppercase font-body mb-2">Country *</label>
            <input
              type="text"
              id="address-country"
              value="Indonesia"
              readonly
              class="w-full px-4 py-3 border border-border bg-foreground/5 font-body"
            />
          </div>
        </div>

        <div class="flex items-center gap-2 pt-4">
          <input type="checkbox" id="address-default" class="w-4 h-4 border-border" />
          <label for="address-default" class="text-sm font-body">Set as default address</label>
        </div>

        <div class="flex gap-3 pt-4">
          <button
            type="button"
            id="cancel-address"
            class="flex-1 py-3 border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="save-address"
            class="flex-1 py-3 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
          >
            Save Address
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  interface Address {
    id: string;
    name: string;
    fullName: string;
    phone: string;
    street: string;
    city: string;
    province: string;
    postal: string;
    country: string;
    isDefault: boolean;
  }

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(price);
  }

  const API_URL = 'http://localhost:4000';

  let addresses: any[] = [];
  let editingId: string | null = null;

  const addressesGrid = document.getElementById('addresses-grid');
  const addressesEmpty = document.getElementById('addresses-empty');
  const addressModal = document.getElementById('address-modal');
  const addressForm = document.getElementById('address-form');
  const modalTitle = document.getElementById('modal-title');
  const addressIdInput = document.getElementById('address-id') as HTMLInputElement;

  // Check authentication
  async function checkAuth() {
    const token = localStorage.getItem('customer_token');
    if (!token) {
      window.location.href = '/login?return=/account/addresses';
      return false;
    }
    return true;
  }

  async function loadAddresses() {
    const isAuth = await checkAuth();
    if (!isAuth) return;

    try {
      const token = localStorage.getItem('customer_token');
      const response = await fetch(`${API_URL}/api/customers/addresses`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!response.ok) {
        throw new Error('Failed to fetch addresses');
      }

      const result = await response.json();
      addresses = result.data || [];
      renderAddresses();
    } catch (e) {
      console.error('Load addresses error:', e);
      addresses = [];
      renderAddresses();
    }
  }

  function renderAddresses() {
    if (addresses.length === 0) {
      addressesGrid?.classList.add('hidden');
      addressesEmpty?.classList.remove('hidden');
      return;
    }

    addressesGrid?.classList.remove('hidden');
    addressesEmpty?.classList.add('hidden');

    if (addressesGrid) {
      addressesGrid.innerHTML = addresses.map(address => `
        <div class="border border-border p-6 relative">
          ${address.is_default ? `
            <span class="absolute top-4 right-4 px-2 py-1 text-xs bg-accent/10 text-accent rounded">Default</span>
          ` : ''}
          
          <h3 class="text-lg font-heading mb-4">${address.label || address.name}</h3>
          
          <div class="space-y-1 text-sm font-body text-foreground/70 mb-6">
            <p class="text-foreground font-medium">${address.full_name}</p>
            <p>${address.address_line1}</p>
            <p>${address.city}, ${address.province} ${address.postal_code}</p>
            <p>${address.country}</p>
            <p class="pt-2">${address.phone}</p>
          </div>

          <div class="flex gap-3">
            <button
              class="edit-address flex-1 py-2 border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
              data-id="${address.id}"
            >
              Edit
            </button>
            <button
              class="delete-address flex-1 py-2 border border-red-500 text-red-500 text-sm tracking-wider uppercase font-body hover:bg-red-500 hover:text-white transition-colors"
              data-id="${address.id}"
            >
              Delete
            </button>
          </div>
        </div>
      `).join('');

      // Attach event listeners
      document.querySelectorAll('.edit-address').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          openModal(id || null);
        });
      });

      document.querySelectorAll('.delete-address').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          deleteAddress(id || '');
        });
      });
    }
  }

  function openModal(id: string | null = null) {
    editingId = id;
    
    if (modalTitle) {
      modalTitle.textContent = id ? 'Edit Address' : 'Add Address';
    }

    if (id) {
      const address = addresses.find(a => a.id === id);
      if (address) {
        addressIdInput.value = address.id;
        (document.getElementById('address-name') as HTMLInputElement).value = address.label || '';
        (document.getElementById('address-full-name') as HTMLInputElement).value = address.full_name || '';
        (document.getElementById('address-phone') as HTMLInputElement).value = address.phone || '';
        (document.getElementById('address-street') as HTMLInputElement).value = address.address_line1 || '';
        (document.getElementById('address-city') as HTMLInputElement).value = address.city || '';
        (document.getElementById('address-province') as HTMLInputElement).value = address.province || '';
        (document.getElementById('address-postal') as HTMLInputElement).value = address.postal_code || '';
        (document.getElementById('address-default') as HTMLInputElement).checked = address.is_default || false;
      }
    } else {
      addressForm?.reset();
    }

    addressModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    addressModal?.classList.add('hidden');
    document.body.style.overflow = '';
    editingId = null;
    addressForm?.reset();
  }

  async function deleteAddress(id: string) {
    if (!confirm('Are you sure you want to delete this address?')) return;

    try {
      const token = localStorage.getItem('customer_token');
      const response = await fetch(`${API_URL}/api/customers/addresses/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!response.ok) {
        throw new Error('Failed to delete address');
      }

      addresses = addresses.filter(a => a.id !== id);
      renderAddresses();
    } catch (e) {
      console.error('Delete address error:', e);
      alert('Failed to delete address');
    }
  }

  async function saveAddress() {
    const formData = {
      label: (document.getElementById('address-name') as HTMLInputElement).value,
      full_name: (document.getElementById('address-full-name') as HTMLInputElement).value,
      phone: (document.getElementById('address-phone') as HTMLInputElement).value,
      address_line1: (document.getElementById('address-street') as HTMLInputElement).value,
      city: (document.getElementById('address-city') as HTMLInputElement).value,
      province: (document.getElementById('address-province') as HTMLInputElement).value,
      postal_code: (document.getElementById('address-postal') as HTMLInputElement).value,
      country: 'Indonesia',
      is_default: (document.getElementById('address-default') as HTMLInputElement).checked,
    };

    try {
      const token = localStorage.getItem('customer_token');
      
      let response;
      if (editingId) {
        // Update
        response = await fetch(`${API_URL}/api/customers/addresses/${editingId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(formData)
        });
      } else {
        // Create
        response = await fetch(`${API_URL}/api/customers/addresses`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(formData)
        });
      }

      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error || 'Failed to save address');
      }

      const result = await response.json();
      const savedAddress = result.data;

      // Update local array
      if (editingId) {
        const index = addresses.findIndex(a => a.id === editingId);
        if (index !== -1) {
          addresses[index] = savedAddress;
        }
      } else {
        addresses.push(savedAddress);
      }

      // If set as default, unset others
      if (formData.is_default) {
        addresses.forEach(a => {
          if (a.id !== savedAddress.id) a.is_default = false;
        });
      }

      renderAddresses();
      closeModal();
    } catch (e: any) {
      console.error('Save address error:', e);
      alert(e.message || 'Failed to save address');
    }
  }

  // Event listeners
  document.getElementById('add-address-btn')?.addEventListener('click', () => openModal());
  document.getElementById('add-first-address-btn')?.addEventListener('click', () => openModal());
  document.getElementById('close-modal')?.addEventListener('click', closeModal);
  document.getElementById('cancel-address')?.addEventListener('click', closeModal);
  document.getElementById('address-modal-backdrop')?.addEventListener('click', closeModal);

  addressForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    saveAddress();
  });

  // Initial load
  loadAddresses();
</script>
