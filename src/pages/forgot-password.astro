---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Forgot Password';
const description = 'Reset your password';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-md">
        <!-- Header -->
        <div class="text-center mb-12">
          <h1 class="text-3xl md:text-4xl font-heading mb-4">Forgot Password?</h1>
          <p class="text-foreground/70 font-body">Enter your email and we'll send you a reset link</p>
        </div>

        <!-- Reset Form -->
        <form id="reset-form" class="space-y-6 mb-8">
          <div>
            <label for="email" class="block text-sm tracking-wider uppercase font-body mb-2">Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
              placeholder="you@example.com"
              autocomplete="email"
            />
          </div>

          <div id="reset-error" class="hidden p-4 bg-red-500/10 border border-red-500/20 text-red-500 text-sm font-body">
            <!-- Error message -->
          </div>

          <div id="reset-success" class="hidden p-4 bg-accent/10 border border-accent/20 text-accent text-sm font-body">
            <!-- Success message -->
          </div>

          <button
            type="submit"
            id="reset-btn"
            class="w-full py-4 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
          >
            Send Reset Link
          </button>
        </form>

        <!-- Back to Login -->
        <div class="text-center">
          <p class="text-sm font-body text-foreground/70">
            Remember your password? 
            <a href="/login" class="text-foreground underline hover:no-underline">
              Back to login
            </a>
          </p>
        </div>

        <!-- Help Text -->
        <div class="mt-12 pt-12 border-t border-border">
          <h3 class="text-sm tracking-wider uppercase font-body mb-4">Need Help?</h3>
          <div class="space-y-3 text-sm text-foreground/70 font-body">
            <p>If you don't receive an email within a few minutes, please check your spam folder.</p>
            <p>Still having trouble? <a href="/contact" class="underline hover:no-underline">Contact our support team</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const resetForm = document.getElementById('reset-form');
  const resetBtn = document.getElementById('reset-btn');
  const resetError = document.getElementById('reset-error');
  const resetSuccess = document.getElementById('reset-success');

  function showError(message: string) {
    if (resetError) {
      resetError.textContent = message;
      resetError.classList.remove('hidden');
    }
    resetSuccess?.classList.add('hidden');
  }

  function showSuccess(message: string) {
    if (resetSuccess) {
      resetSuccess.textContent = message;
      resetSuccess.classList.remove('hidden');
    }
    resetError?.classList.add('hidden');
  }

  function hideMessages() {
    resetError?.classList.add('hidden');
    resetSuccess?.classList.add('hidden');
  }

  resetForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMessages();

    const email = (document.getElementById('email') as HTMLInputElement).value;

    if (!email) {
      showError('Please enter your email address');
      return;
    }

    // Show loading state
    if (resetBtn) {
      resetBtn.textContent = 'Sending...';
      resetBtn.setAttribute('disabled', 'true');
    }

    // Simulate API delay
    await new Promise(resolve => setTimeout(resolve, 1500));

    // In production, this would send actual reset email
    // For demo, we'll just show success message
    showSuccess('✓ Password reset link sent! Check your email for instructions.');

    if (resetBtn) {
      resetBtn.textContent = 'Send Reset Link';
      resetBtn.removeAttribute('disabled');
    }

    // Clear form
    (document.getElementById('email') as HTMLInputElement).value = '';
  });
</script>
