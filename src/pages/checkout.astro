---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Checkout';
const description = 'Complete your purchase';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom max-w-6xl">
        <!-- Header -->
        <div class="text-center mb-12">
          <h1 class="text-3xl md:text-4xl font-heading mb-4">Checkout</h1>
          <!-- Progress Steps -->
          <div class="flex items-center justify-center gap-2 md:gap-4 max-w-md mx-auto">
            <div class="flex items-center gap-2">
              <div id="step-1-indicator" class="w-8 h-8 rounded-full bg-foreground text-background flex items-center justify-center text-sm font-body">1</div>
              <span id="step-1-label" class="text-sm font-body hidden md:inline">Contact</span>
            </div>
            <div class="w-8 md:w-16 h-px bg-border"></div>
            <div class="flex items-center gap-2">
              <div id="step-2-indicator" class="w-8 h-8 rounded-full bg-border text-foreground/40 flex items-center justify-center text-sm font-body">2</div>
              <span id="step-2-label" class="text-sm font-body text-foreground/40 hidden md:inline">Shipping</span>
            </div>
            <div class="w-8 md:w-16 h-px bg-border"></div>
            <div class="flex items-center gap-2">
              <div id="step-3-indicator" class="w-8 h-8 rounded-full bg-border text-foreground/40 flex items-center justify-center text-sm font-body">3</div>
              <span id="step-3-label" class="text-sm font-body text-foreground/40 hidden md:inline">Payment</span>
            </div>
          </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Checkout Form -->
          <div class="lg:col-span-2">
            <form id="checkout-form">
              <!-- Step 1: Contact Information -->
              <div id="step-1" class="checkout-step">
                <h2 class="text-xl tracking-wider uppercase font-body mb-6">Contact Information</h2>
                
                <div class="space-y-4">
                  <div>
                    <label for="email" class="block text-sm tracking-wider uppercase font-body mb-2">Email *</label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                      placeholder="you@example.com"
                    />
                    <p id="email-error" class="text-xs text-red-500 mt-1 hidden"></p>
                  </div>

                  <div>
                    <label for="phone" class="block text-sm tracking-wider uppercase font-body mb-2">Phone Number *</label>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                      placeholder="+62 812 3456 7890"
                    />
                    <p id="phone-error" class="text-xs text-red-500 mt-1 hidden"></p>
                  </div>

                  <div class="flex items-center gap-2">
                    <input
                      type="checkbox"
                      id="create-account"
                      class="w-4 h-4 border-border"
                    />
                    <label for="create-account" class="text-sm font-body text-foreground/70">
                      Create an account for faster checkout next time
                    </label>
                  </div>
                </div>

                <button
                  type="button"
                  id="continue-to-shipping"
                  class="w-full mt-8 py-4 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
                >
                  Continue to Shipping
                </button>
              </div>

              <!-- Step 2: Shipping Information -->
              <div id="step-2" class="checkout-step hidden">
                <h2 class="text-xl tracking-wider uppercase font-body mb-6">Shipping Address</h2>
                
                <div class="space-y-4">
                  <div>
                    <label for="full-name" class="block text-sm tracking-wider uppercase font-body mb-2">Full Name *</label>
                    <input
                      type="text"
                      id="full-name"
                      name="fullName"
                      required
                      class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                      placeholder="John Doe"
                    />
                    <p id="full-name-error" class="text-xs text-red-500 mt-1 hidden"></p>
                  </div>

                  <div>
                    <label for="address" class="block text-sm tracking-wider uppercase font-body mb-2">Address *</label>
                    <input
                      type="text"
                      id="address"
                      name="address"
                      required
                      class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                      placeholder="Street address"
                    />
                    <p id="address-error" class="text-xs text-red-500 mt-1 hidden"></p>
                  </div>

                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="city" class="block text-sm tracking-wider uppercase font-body mb-2">City *</label>
                      <input
                        type="text"
                        id="city"
                        name="city"
                        required
                        class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                        placeholder="Jakarta"
                      />
                      <p id="city-error" class="text-xs text-red-500 mt-1 hidden"></p>
                    </div>

                    <div>
                      <label for="province" class="block text-sm tracking-wider uppercase font-body mb-2">Province *</label>
                      <select
                        id="province"
                        name="province"
                        required
                        class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                      >
                        <option value="">Select Province</option>
                        <option value="jakarta">DKI Jakarta</option>
                        <option value="west-java">West Java</option>
                        <option value="east-java">East Java</option>
                        <option value="central-java">Central Java</option>
                        <option value="bali">Bali</option>
                        <option value="other">Other</option>
                      </select>
                      <p id="province-error" class="text-xs text-red-500 mt-1 hidden"></p>
                    </div>
                  </div>

                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="postal-code" class="block text-sm tracking-wider uppercase font-body mb-2">Postal Code *</label>
                      <input
                        type="text"
                        id="postal-code"
                        name="postalCode"
                        required
                        class="w-full px-4 py-3 border border-border focus:outline-none focus:border-foreground font-body"
                        placeholder="12345"
                      />
                      <p id="postal-code-error" class="text-xs text-red-500 mt-1 hidden"></p>
                    </div>

                    <div>
                      <label for="country" class="block text-sm tracking-wider uppercase font-body mb-2">Country *</label>
                      <input
                        type="text"
                        id="country"
                        name="country"
                        value="Indonesia"
                        readonly
                        class="w-full px-4 py-3 border border-border bg-foreground/5 font-body"
                      />
                    </div>
                  </div>

                  <!-- Shipping Method -->
                  <div class="mt-8">
                    <label class="block text-sm tracking-wider uppercase font-body mb-4">Shipping Method *</label>
                    <div class="space-y-3">
                      <label class="flex items-center justify-between p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                        <div class="flex items-center gap-3">
                          <input type="radio" name="shipping" value="regular" checked class="w-4 h-4" />
                          <div>
                            <p class="text-sm font-body font-medium">Regular Shipping</p>
                            <p class="text-xs text-foreground/60 font-body">3-5 business days</p>
                          </div>
                        </div>
                        <span class="text-sm font-body font-medium">Rp15.000</span>
                      </label>

                      <label class="flex items-center justify-between p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                        <div class="flex items-center gap-3">
                          <input type="radio" name="shipping" value="express" class="w-4 h-4" />
                          <div>
                            <p class="text-sm font-body font-medium">Express Shipping</p>
                            <p class="text-xs text-foreground/60 font-body">1-2 business days</p>
                          </div>
                        </div>
                        <span class="text-sm font-body font-medium">Rp35.000</span>
                      </label>

                      <label class="flex items-center justify-between p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                        <div class="flex items-center gap-3">
                          <input type="radio" name="shipping" value="sameday" class="w-4 h-4" />
                          <div>
                            <p class="text-sm font-body font-medium">Same Day Delivery</p>
                            <p class="text-xs text-foreground/60 font-body">Order before 12 PM</p>
                          </div>
                        </div>
                        <span class="text-sm font-body font-medium">Rp50.000</span>
                      </label>
                    </div>
                  </div>
                </div>

                <div class="flex gap-4 mt-8">
                  <button
                    type="button"
                    id="back-to-contact"
                    class="flex-1 py-4 border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
                  >
                    Back
                  </button>
                  <button
                    type="button"
                    id="continue-to-payment"
                    class="flex-1 py-4 bg-foreground text-background text-sm tracking-wider uppercase font-body hover:bg-foreground/90 transition-colors"
                  >
                    Continue to Payment
                  </button>
                </div>
              </div>

              <!-- Step 3: Payment -->
              <div id="step-3" class="checkout-step hidden">
                <h2 class="text-xl tracking-wider uppercase font-body mb-6">Payment Method</h2>
                
                <div class="space-y-3 mb-8">
                  <label class="flex items-start gap-3 p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                    <input type="radio" name="payment" value="qris" checked class="w-4 h-4 mt-1" />
                    <div class="flex-1">
                      <p class="text-sm font-body font-medium mb-1">QRIS</p>
                      <p class="text-xs text-foreground/60 font-body">Scan QR code to pay</p>
                    </div>
                  </label>

                  <label class="flex items-start gap-3 p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                    <input type="radio" name="payment" value="bank-transfer" class="w-4 h-4 mt-1" />
                    <div class="flex-1">
                      <p class="text-sm font-body font-medium mb-1">Bank Transfer</p>
                      <p class="text-xs text-foreground/60 font-body">BCA, Mandiri, BNI, BRI</p>
                    </div>
                  </label>

                  <label class="flex items-start gap-3 p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                    <input type="radio" name="payment" value="ewallet" class="w-4 h-4 mt-1" />
                    <div class="flex-1">
                      <p class="text-sm font-body font-medium mb-1">E-Wallet</p>
                      <p class="text-xs text-foreground/60 font-body">GoPay, OVO, DANA, ShopeePay</p>
                    </div>
                  </label>

                  <label class="flex items-start gap-3 p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                    <input type="radio" name="payment" value="card" class="w-4 h-4 mt-1" />
                    <div class="flex-1">
                      <p class="text-sm font-body font-medium mb-1">Credit/Debit Card</p>
                      <p class="text-xs text-foreground/60 font-body">Visa, Mastercard, JCB</p>
                    </div>
                  </label>

                  <label class="flex items-start gap-3 p-4 border border-border hover:border-foreground cursor-pointer transition-colors">
                    <input type="radio" name="payment" value="cod" class="w-4 h-4 mt-1" />
                    <div class="flex-1">
                      <p class="text-sm font-body font-medium mb-1">Cash on Delivery</p>
                      <p class="text-xs text-foreground/60 font-body">Pay when you receive</p>
                    </div>
                  </label>
                </div>

                <div class="flex gap-4">
                  <button
                    type="button"
                    id="back-to-shipping"
                    class="flex-1 py-4 border border-border text-sm tracking-wider uppercase font-body hover:bg-foreground hover:text-background transition-colors"
                  >
                    Back
                  </button>
                  <button
                    type="submit"
                    id="place-order"
                    class="flex-1 py-4 bg-accent text-white text-sm tracking-wider uppercase font-body hover:bg-accent/90 transition-colors"
                  >
                    Place Order
                  </button>
                </div>
              </div>
            </form>
          </div>

          <!-- Order Summary -->
          <div class="lg:col-span-1">
            <div class="border border-border p-6 sticky top-36">
              <h2 class="text-lg tracking-wider uppercase font-body mb-6">Order Summary</h2>

              <!-- Items -->
              <div id="checkout-items" class="space-y-4 mb-6 max-h-64 overflow-y-auto">
                <!-- Populated by JavaScript -->
              </div>

              <!-- Totals -->
              <div class="space-y-3 pt-6 border-t border-border">
                <div class="flex items-center justify-between text-sm font-body">
                  <span class="text-foreground/70">Subtotal</span>
                  <span id="checkout-subtotal">Rp0</span>
                </div>
                <div class="flex items-center justify-between text-sm font-body">
                  <span class="text-foreground/70">Shipping</span>
                  <span id="checkout-shipping">Rp15.000</span>
                </div>
                <div class="flex items-center justify-between text-base font-body pt-3 border-t border-border">
                  <span class="font-medium">Total</span>
                  <span id="checkout-total" class="font-medium text-lg">Rp0</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  interface CartItem {
    productId: string;
    product: {
      id: string;
      name: string;
      slug: string;
      price: number;
      thumbnail: string;
    };
    quantity: number;
    price: number;
  }

  const SHIPPING_COSTS = {
    regular: 15000,
    express: 35000,
    sameday: 50000,
  };

  let currentStep = 1;
  let shippingCost = SHIPPING_COSTS.regular;

  // Validation utilities
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const phoneRegex = /^(\+62|62|0)[0-9]{9,12}$/;
  const postalCodeRegex = /^[0-9]{5}$/;

  function showFieldError(fieldId: string, message: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement;
    const error = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.add('border-red-500');
      field.classList.remove('border-border');
    }
    if (error) {
      error.textContent = message;
      error.classList.remove('hidden');
    }
  }

  function clearFieldError(fieldId: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement;
    const error = document.getElementById(`${fieldId}-error`);
    
    if (field) {
      field.classList.remove('border-red-500');
      field.classList.add('border-border');
    }
    if (error) {
      error.textContent = '';
      error.classList.add('hidden');
    }
  }

  function validateEmail(email: string): boolean {
    return emailRegex.test(email);
  }

  function validatePhone(phone: string): boolean {
    return phoneRegex.test(phone.replace(/[\s-]/g, ''));
  }

  function validatePostalCode(code: string): boolean {
    return postalCodeRegex.test(code);
  }

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(price);
  }

  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('roquace_cart') || '[]');
    } catch {
      return [];
    }
  }

  // Auto-fill shipping address for logged-in customers
  async function autoFillAddress() {
    try {
      const token = localStorage.getItem('customer_token');
      if (!token) return;

      const response = await fetch(`${import.meta.env.PUBLIC_API_URL || ''}/api/customers/addresses`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!response.ok) return;

      const result = await response.json();
      const addresses = result.data || [];

      if (addresses.length === 0) return;

      // Find default address or use first one
      const defaultAddress = addresses.find((a: any) => a.is_default) || addresses[0];

      // Auto-fill form fields
      const fullName = document.getElementById('full-name') as HTMLInputElement;
      const address = document.getElementById('address') as HTMLInputElement;
      const city = document.getElementById('city') as HTMLInputElement;
      const province = document.getElementById('province') as HTMLSelectElement;
      const postalCode = document.getElementById('postal-code') as HTMLInputElement;
      const phone = document.getElementById('phone') as HTMLInputElement;

      if (fullName) fullName.value = defaultAddress.full_name || '';
      if (address) address.value = defaultAddress.address_line1 || '';
      if (city) city.value = defaultAddress.city || '';
      if (province) province.value = defaultAddress.province || '';
      if (postalCode) postalCode.value = defaultAddress.postal_code || '';
      if (phone) phone.value = defaultAddress.phone || '';

    } catch (e) {
      console.error('Failed to auto-fill address:', e);
    }
  }

  function updateStep(step: number) {
    currentStep = step;

    // Hide all steps
    document.querySelectorAll('.checkout-step').forEach(el => el.classList.add('hidden'));
    
    // Show current step
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Update indicators
    for (let i = 1; i <= 3; i++) {
      const indicator = document.getElementById(`step-${i}-indicator`);
      const label = document.getElementById(`step-${i}-label`);
      
      if (i < step) {
        // Completed
        indicator?.classList.remove('bg-border', 'text-foreground/40', 'bg-foreground', 'text-background');
        indicator?.classList.add('bg-accent', 'text-white');
        label?.classList.remove('text-foreground/40');
        label?.classList.add('text-accent');
      } else if (i === step) {
        // Current
        indicator?.classList.remove('bg-border', 'text-foreground/40', 'bg-accent', 'text-white');
        indicator?.classList.add('bg-foreground', 'text-background');
        label?.classList.remove('text-foreground/40', 'text-accent');
      } else {
        // Upcoming
        indicator?.classList.remove('bg-foreground', 'text-background', 'bg-accent', 'text-white');
        indicator?.classList.add('bg-border', 'text-foreground/40');
        label?.classList.add('text-foreground/40');
        label?.classList.remove('text-accent');
      }
    }

    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderOrderSummary() {
    const cart = getCart();
    const checkoutItems = document.getElementById('checkout-items');
    const checkoutSubtotal = document.getElementById('checkout-subtotal');
    const checkoutShipping = document.getElementById('checkout-shipping');
    const checkoutTotal = document.getElementById('checkout-total');

    if (cart.length === 0) {
      window.location.href = '/cart';
      return;
    }

    // Render items
    if (checkoutItems) {
      checkoutItems.innerHTML = cart.map(item => `
        <div class="flex gap-3">
          <div class="w-16 h-20 flex-shrink-0 bg-foreground/5">
            <img src="${item.product.thumbnail}" alt="${item.product.name}" class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-body mb-1 truncate">${item.product.name}</p>
            <p class="text-xs text-foreground/60 font-body">Qty: ${item.quantity}</p>
            <p class="text-sm font-body font-medium mt-1">${formatPrice(item.price * item.quantity)}</p>
          </div>
        </div>
      `).join('');
    }

    // Calculate totals
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const total = subtotal + shippingCost;

    if (checkoutSubtotal) checkoutSubtotal.textContent = formatPrice(subtotal);
    if (checkoutShipping) checkoutShipping.textContent = formatPrice(shippingCost);
    if (checkoutTotal) checkoutTotal.textContent = formatPrice(total);
  }

  // Real-time validation
  const emailField = document.getElementById('email') as HTMLInputElement;
  const phoneField = document.getElementById('phone') as HTMLInputElement;
  const fullNameField = document.getElementById('full-name') as HTMLInputElement;
  const addressField = document.getElementById('address') as HTMLInputElement;
  const cityField = document.getElementById('city') as HTMLInputElement;
  const provinceField = document.getElementById('province') as HTMLSelectElement;
  const postalCodeField = document.getElementById('postal-code') as HTMLInputElement;

  emailField?.addEventListener('blur', () => {
    const value = emailField.value.trim();
    if (value && !validateEmail(value)) {
      showFieldError('email', 'Please enter a valid email address');
    } else {
      clearFieldError('email');
    }
  });

  phoneField?.addEventListener('blur', () => {
    const value = phoneField.value.trim();
    if (value && !validatePhone(value)) {
      showFieldError('phone', 'Please enter a valid phone number (e.g., +62812345678)');
    } else {
      clearFieldError('phone');
    }
  });

  postalCodeField?.addEventListener('blur', () => {
    const value = postalCodeField.value.trim();
    if (value && !validatePostalCode(value)) {
      showFieldError('postal-code', 'Postal code must be 5 digits');
    } else {
      clearFieldError('postal-code');
    }
  });

  // Navigation
  document.getElementById('continue-to-shipping')?.addEventListener('click', () => {
    const email = emailField.value.trim();
    const phone = phoneField.value.trim();

    let hasError = false;

    if (!email) {
      showFieldError('email', 'Email is required');
      hasError = true;
    } else if (!validateEmail(email)) {
      showFieldError('email', 'Please enter a valid email address');
      hasError = true;
    } else {
      clearFieldError('email');
    }

    if (!phone) {
      showFieldError('phone', 'Phone number is required');
      hasError = true;
    } else if (!validatePhone(phone)) {
      showFieldError('phone', 'Please enter a valid phone number');
      hasError = true;
    } else {
      clearFieldError('phone');
    }

    if (hasError) return;

    updateStep(2);
  });

  document.getElementById('back-to-contact')?.addEventListener('click', () => {
    updateStep(1);
  });

  document.getElementById('continue-to-payment')?.addEventListener('click', () => {
    const fullName = fullNameField.value.trim();
    const address = addressField.value.trim();
    const city = cityField.value.trim();
    const province = provinceField.value;
    const postalCode = postalCodeField.value.trim();

    let hasError = false;

    if (!fullName) {
      showFieldError('full-name', 'Full name is required');
      hasError = true;
    } else if (fullName.length < 3) {
      showFieldError('full-name', 'Name must be at least 3 characters');
      hasError = true;
    } else {
      clearFieldError('full-name');
    }

    if (!address) {
      showFieldError('address', 'Address is required');
      hasError = true;
    } else if (address.length < 10) {
      showFieldError('address', 'Please enter a complete address');
      hasError = true;
    } else {
      clearFieldError('address');
    }

    if (!city) {
      showFieldError('city', 'City is required');
      hasError = true;
    } else {
      clearFieldError('city');
    }

    if (!province) {
      showFieldError('province', 'Please select a province');
      hasError = true;
    } else {
      clearFieldError('province');
    }

    if (!postalCode) {
      showFieldError('postal-code', 'Postal code is required');
      hasError = true;
    } else if (!validatePostalCode(postalCode)) {
      showFieldError('postal-code', 'Postal code must be 5 digits');
      hasError = true;
    } else {
      clearFieldError('postal-code');
    }

    if (hasError) return;

    updateStep(3);
  });

  document.getElementById('back-to-shipping')?.addEventListener('click', () => {
    updateStep(2);
  });

  // Shipping method change
  document.querySelectorAll('input[name="shipping"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const value = (e.target as HTMLInputElement).value as keyof typeof SHIPPING_COSTS;
      shippingCost = SHIPPING_COSTS[value];
      renderOrderSummary();
    });
  });

  // Form submission
  document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const paymentMethod = (document.querySelector('input[name="payment"]:checked') as HTMLInputElement)?.value;

    if (!paymentMethod) {
      alert('Please select a payment method');
      return;
    }

    // Get form data
    const formData = new FormData(e.target as HTMLFormElement);
    const cart = getCart();
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

    // Get applied coupon from localStorage
    let appliedCoupon = null;
    let discount = 0;
    let discountCode = null;
    
    try {
      const couponData = localStorage.getItem('roquace_applied_coupon');
      if (couponData) {
        appliedCoupon = JSON.parse(couponData);
        discount = appliedCoupon.discount_amount || 0;
        discountCode = appliedCoupon.code;
      }
    } catch (e) {
      console.error('Failed to load coupon:', e);
    }

    // Get customer ID if logged in
    let customerId = null;
    try {
      const token = localStorage.getItem('customer_token');
      if (token) {
        const response = await fetch(`${import.meta.env.PUBLIC_API_URL || ''}/api/customers/customer-verify`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (response.ok) {
          const result = await response.json();
          customerId = result.customer.id;
        }
      }
    } catch (e) {
      console.error('Failed to verify customer:', e);
    }

    // Prepare order data
    const orderData = {
      customer_id: customerId,
      customer_email: formData.get('email'),
      customer_name: formData.get('fullName'),
      customer_phone: formData.get('phone'),
      shipping_address: {
        full_name: formData.get('fullName'),
        phone: formData.get('phone'),
        address_line1: formData.get('address'),
        address_line2: formData.get('apartment') || '',
        city: formData.get('city'),
        province: formData.get('province'),
        postal_code: formData.get('postalCode'),
        country: formData.get('country') || 'Indonesia'
      },
      shipping_method: formData.get('shipping') || 'regular',
      shipping_cost: shippingCost,
      items: cart.map(item => ({
        product_id: item.product.id,
        name: item.product.name,
        slug: item.product.slug,
        price: item.price,
        quantity: item.quantity,
        image: item.product.thumbnail
      })),
      subtotal: subtotal,
      discount: discount,
      discount_code: discountCode,
      payment_method: paymentMethod
    };

    try {
      // Show loading
      const submitBtn = e.target.querySelector('button[type="submit"]');
      const originalText = submitBtn?.textContent;
      if (submitBtn) submitBtn.textContent = 'Processing...';
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');

      // Submit to API
      const response = await fetch(`${import.meta.env.PUBLIC_API_URL || ''}/api/orders`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(orderData)
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Failed to create order');
      }

      // Clear cart and coupon
      localStorage.setItem('roquace_cart', '[]');
      localStorage.removeItem('roquace_applied_coupon');
      window.dispatchEvent(new CustomEvent('cart-updated'));

      // Save order ID for success page
      localStorage.setItem('roquace_last_order', JSON.stringify({
        orderId: result.data.id,
        total: result.data.total_amount,
        date: result.data.created_at
      }));

      // Redirect to confirmation
      window.location.href = `/order/success?orderId=${result.data.id}`;
    } catch (error) {
      console.error('Order submission error:', error);
      alert(error.message || 'Failed to process order. Please try again.');
      
      // Reset button
      const submitBtn = e.target.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.textContent = 'Complete Order';
      if (submitBtn) submitBtn.removeAttribute('disabled');
    }
  });

  // Initial render
  renderOrderSummary();
  autoFillAddress();
</script>
