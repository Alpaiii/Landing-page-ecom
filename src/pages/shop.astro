---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import ProductListing from '../components/ProductListing.astro';
import Footer from '../components/Footer.astro';
import { fetchProducts } from '../utils/productApi';
import { siteConfig } from '../config/site';

const products = await fetchProducts();

const title = 'Shop';
const description =
  'Discover our curated collection of contemporary fashion pieces. Shop the latest trends in women, men, and accessories.';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <ProductListing
      products={products}
      heading={title}
      eyebrow={siteConfig.name}
      intro={description}
    />
  </main>

  <Footer />
</Layout>
