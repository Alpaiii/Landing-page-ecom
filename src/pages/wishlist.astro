---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Wishlist';
const description = 'Your saved items';
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom">
        <!-- Header -->
        <div class="mb-12">
          <h1 class="text-3xl md:text-4xl font-heading mb-2">Your Wishlist</h1>
          <p id="wishlist-count-text" class="text-foreground/60 font-body">0 items</p>
        </div>

        <!-- Wishlist Grid -->
        <div id="wishlist-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Empty State -->
        <div id="empty-wishlist" class="hidden text-center py-16">
          <svg class="w-20 h-20 mx-auto mb-6 text-foreground/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <h2 class="text-2xl font-heading mb-2">Your wishlist is empty</h2>
          <p class="text-foreground/60 font-body mb-8">Save pieces you love to your wishlist</p>
          <a href="/shop" class="btn-secondary inline-block">
            Explore Collection
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { mapApiProduct } from '../utils/productApi';

  const API_URL = import.meta.env.PUBLIC_API_URL || '/api';
  const wishlistGrid = document.getElementById('wishlist-grid');
  const emptyWishlist = document.getElementById('empty-wishlist');
  const wishlistCountText = document.getElementById('wishlist-count-text');

  let products: any[] = [];

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
    }).format(price);
  }

  async function loadWishlist() {
    try {
      const response = await fetch(`${API_URL}/products`);
      if (!response.ok) throw new Error('Failed to load products');
      const result = await response.json();
      products = (result.data || []).map(mapApiProduct);

      const wishlistIds = JSON.parse(localStorage.getItem('roquace-wishlist') || '[]');
      
      if (wishlistIds.length === 0) {
        showEmpty();
        return;
      }

      // Filter products that are in wishlist
      const wishlistProducts = products.filter((p: any) => wishlistIds.includes(p.id));

      if (wishlistProducts.length === 0) {
        showEmpty();
        return;
      }

      // Update count
      updateCount(wishlistProducts.length);

      // Render products
      if (wishlistGrid) {
        wishlistGrid.innerHTML = wishlistProducts.map((product: any) => {
          const discount = product.compareAtPrice 
            ? Math.round(((product.compareAtPrice - product.price) / product.compareAtPrice) * 100)
            : 0;

          return `
            <div class="group" data-product-id="${product.id}">
              <a href="/products/${escapeHtml(product.slug)}" class="block relative aspect-[4/5] overflow-hidden mb-4 bg-foreground/5">
                <img
                  src="${escapeHtml(product.thumbnail)}"
                  alt="${escapeHtml(product.name)}"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                
                ${product.badge ? `
                  <span class="absolute top-4 left-4 bg-foreground text-background text-xs px-3 py-1.5 tracking-wider uppercase font-body">
                    ${escapeHtml(product.badge)}
                    ${product.badge === 'Sale' && discount > 0 ? ` -${discount}%` : ''}
                  </span>
                ` : ''}
                
                <button
                  class="remove-wishlist-btn absolute top-4 right-4 w-10 h-10 bg-background/90 backdrop-blur-sm text-foreground flex items-center justify-center hover:bg-red-500 hover:text-white transition-all"
                  data-product-id="${product.id}"
                  aria-label="Remove from wishlist"
                >
                  <svg class="w-5 h-5" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                </button>
              </a>
              
              <div>
                ${product.subcategory ? `
                  <p class="text-xs tracking-wider uppercase text-foreground/50 font-body mb-1">
                    ${escapeHtml(product.subcategory)}
                  </p>
                ` : ''}
                
                <h3 class="font-heading text-base md:text-lg mb-2">
                  <a href="/products/${escapeHtml(product.slug)}" class="hover:text-accent transition-colors">
                    ${escapeHtml(product.name)}
                  </a>
                </h3>
                
                ${product.rating > 0 ? `
                  <div class="flex items-center gap-2 mb-2">
                    <div class="flex items-center gap-0.5">
                      ${[...Array(5)].map((_, i) => `
                        <svg
                          class="w-3.5 h-3.5 ${i < Math.floor(product.rating) ? 'text-accent' : 'text-foreground/20'}"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      `).join('')}
                    </div>
                    <span class="text-xs text-muted font-body">${product.rating} (${product.reviewCount})</span>
                  </div>
                ` : ''}
                
                <div class="flex items-center gap-2 mb-3">
                  <p class="text-base font-body font-medium">${formatPrice(product.price)}</p>
                  ${product.compareAtPrice ? `
                    <p class="text-sm text-muted font-body line-through">${formatPrice(product.compareAtPrice)}</p>
                    ${discount > 0 ? `<span class="text-xs text-accent font-body font-medium">-${discount}%</span>` : ''}
                  ` : ''}
                </div>
                
                <button
                  class="move-to-cart-btn w-full py-2.5 text-sm tracking-wider uppercase font-body border border-border hover:bg-foreground hover:text-background transition-colors"
                  data-product-id="${product.id}"
                >
                  Move to Cart
                </button>
              </div>
            </div>
          `;
        }).join('');

        // Add event listeners
        attachEventListeners();
      }

      showGrid();

    } catch (e) {
      console.error('Error loading wishlist:', e);
      showEmpty();
    }
  }

  function showEmpty() {
    wishlistGrid?.classList.add('hidden');
    emptyWishlist?.classList.remove('hidden');
    updateCount(0);
  }

  function showGrid() {
    wishlistGrid?.classList.remove('hidden');
    emptyWishlist?.classList.add('hidden');
  }

  function updateCount(count: number) {
    if (wishlistCountText) {
      wishlistCountText.textContent = `${count} item${count !== 1 ? 's' : ''}`;
    }
  }

  function removeFromWishlist(productId: string) {
    try {
      let wishlist = JSON.parse(localStorage.getItem('roquace-wishlist') || '[]');
      wishlist = wishlist.filter((id: string) => id !== productId);
      localStorage.setItem('roquace-wishlist', JSON.stringify(wishlist));
      
      window.dispatchEvent(new CustomEvent('wishlist-updated'));
      loadWishlist();
    } catch (e) {
      console.error('Error removing from wishlist:', e);
    }
  }

  function moveToCart(productId: string) {
    const product = products.find((p: any) => p.id === productId);
    if (!product) return;

    try {
      const color = product.colors?.[0]?.name ?? '';
      const size = product.sizes?.find((option: any) => option.available)?.name ?? product.sizes?.[0]?.name ?? '';
      const cart = JSON.parse(localStorage.getItem('roquace_cart') || '[]');
      const existing = cart.find(
        (item: any) => item.productId === product.id && item.color === color && item.size === size
      );

      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          productId: product.id,
          product,
          color,
          size,
          quantity: 1,
          price: product.price,
        });
      }

      localStorage.setItem('roquace_cart', JSON.stringify(cart));
      
      // Remove from wishlist
      removeFromWishlist(productId);
      
      window.dispatchEvent(new CustomEvent('cart-updated'));
      
      // Show feedback
      alert('Product moved to cart!');
    } catch (e) {
      console.error('Error moving to cart:', e);
    }
  }

  function attachEventListeners() {
    // Remove buttons
    document.querySelectorAll('.remove-wishlist-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productId = (btn as HTMLElement).dataset.productId;
        if (productId) removeFromWishlist(productId);
      });
    });

    // Move to cart buttons
    document.querySelectorAll('.move-to-cart-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const productId = (btn as HTMLElement).dataset.productId;
        if (productId) moveToCart(productId);
      });
    });
  }

  // Listen to wishlist updates
  window.addEventListener('wishlist-updated', loadWishlist);

  // Initial load
  loadWishlist();
</script>
