---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';
import { categories } from '../data/categories';
import { collections } from '../data/collections';
import { siteConfig } from '../config/site';

const title = 'Shop';
const description = 'Discover our curated collection of contemporary fashion pieces. Shop the latest trends in women, men, and accessories.';

const shopCategories = categories.filter((c) => c.id !== 'new-arrivals');

// The site is built statically, so `?category=` / `?filter=` / `?collection=` are
// read by the client script below instead of at build time. Every card is always
// rendered and then shown or hidden.
interface FilterMeta {
  key: string;
  heading: string;
  subcopy: string;
}

const filterMeta: FilterMeta[] = [
  ...shopCategories.map<FilterMeta>((category) => ({
    key: `category:${category.id}`,
    heading: category.name,
    subcopy: category.description,
  })),
  { key: 'filter:new', heading: 'New Arrivals', subcopy: 'Fresh styles just dropped. Be the first to shop our latest pieces.' },
  { key: 'filter:bestseller', heading: 'Best Sellers', subcopy: "Customer favorites you'll love. The pieces our community loves most." },
  ...collections.map<FilterMeta>((collection) => ({
    key: `collection:${collection.slug}`,
    heading: collection.name,
    subcopy: collection.description,
  })),
];

// Only collections that can be derived from product data are filterable.
// `essentials` and `autumn-2026` have no membership rule in src/data/collections.ts,
// so they fall through to the full catalogue.
const collectionMembers: Record<string, string[]> = {
  'new-arrivals': products.filter((p) => p.badge === 'New').map((p) => p.id),
  'best-sellers': products.filter((p) => p.badge === 'Best Seller').map((p) => p.id),
};

const filterMetaJson = JSON.stringify(filterMeta).replace(/</g, '\\u003c');
const collectionMembersJson = JSON.stringify(collectionMembers).replace(/</g, '\\u003c');

const sortOptions = [
  { value: 'featured', label: 'Featured' },
  { value: 'newest', label: 'Newest' },
  { value: 'price-low', label: 'Price: Low to High' },
  { value: 'price-high', label: 'Price: High to Low' },
  { value: 'bestselling', label: 'Best Selling' },
];
---

<Layout title={title} description={description}>
  <AnnouncementBar />
  <Navbar />

  <main class="pt-32 md:pt-36">
    <section class="section-padding">
      <div class="container-custom">
        <div class="text-center mb-12">
          <h1 id="shop-heading" data-site-name={siteConfig.name} class="heading-xl mb-4">{title}</h1>
          <p id="shop-subcopy" class="text-foreground/60 font-body max-w-xl mx-auto">{description}</p>
        </div>

        <!-- Filters & Sort Bar -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
          <!-- Category Filters -->
          <div class="flex flex-wrap gap-3">
            <a
              href="/shop"
              data-filter-key="all"
              class="filter-pill px-5 py-2.5 text-sm tracking-wider uppercase font-body bg-foreground text-background transition-colors"
            >
              All
            </a>
            {shopCategories.map((category) => (
              <a
                href={`/shop?category=${category.slug}`}
                data-filter-key={`category:${category.id}`}
                class="filter-pill px-5 py-2.5 text-sm tracking-wider uppercase font-body border border-border hover:bg-foreground hover:text-background transition-colors"
              >
                {category.name}
              </a>
            ))}
          </div>

          <!-- Sort Dropdown -->
          <div class="relative">
            <select
              id="sort-select"
              class="appearance-none px-5 py-2.5 pr-10 text-sm tracking-wider uppercase font-body border border-border bg-background cursor-pointer focus:outline-none focus:border-foreground"
            >
              {sortOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
            <svg class="w-4 h-4 absolute right-4 top-1/2 -translate-y-2/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

        <!-- Product Count -->
        <p id="shop-count" class="text-sm text-muted font-body mb-8">
          Showing {products.length} product{products.length !== 1 ? 's' : ''}
        </p>

        <!-- Products Grid: every product is rendered, the script filters the DOM -->
        <div id="shop-grid">
          <ProductGrid products={products} />
        </div>

        <div id="shop-empty" class="hidden text-center py-16">
          <p class="text-muted font-body mb-6">No products found.</p>
          <a href="/shop" class="btn-secondary">View All Products</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline type="application/json" id="shop-filter-meta" set:html={filterMetaJson}></script>
  <script is:inline type="application/json" id="shop-collection-members" set:html={collectionMembersJson}></script>

  <script>
    const grid = document.getElementById('shop-grid');
    const emptyState = document.getElementById('shop-empty');
    const countEl = document.getElementById('shop-count');
    const headingEl = document.getElementById('shop-heading');
    const subcopyEl = document.getElementById('shop-subcopy');
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;

    const cards = () => Array.from(grid?.querySelectorAll<HTMLElement>('[data-product-card]') ?? []);

    function readJson<T>(id: string, fallback: T): T {
      const el = document.getElementById(id);
      if (!el?.textContent) return fallback;
      try {
        return JSON.parse(el.textContent) as T;
      } catch {
        return fallback;
      }
    }

    const filterMeta = readJson<{ key: string; heading: string; subcopy: string }[]>('shop-filter-meta', []);
    const collectionMembers = readJson<Record<string, string[]>>('shop-collection-members', {});

    const PILL_ACTIVE = ['bg-foreground', 'text-background'];
    const PILL_IDLE = ['border', 'border-border'];

    function setPillState(activeKey: string): void {
      document.querySelectorAll<HTMLElement>('.filter-pill').forEach((pill) => {
        const isActive = pill.dataset.filterKey === activeKey;
        const tokens = isActive ? PILL_ACTIVE : PILL_IDLE;
        PILL_ACTIVE.concat(PILL_IDLE).forEach((token) => pill.classList.toggle(token, tokens.includes(token)));
      });
    }

    function matches(card: HTMLElement, category: string | null, filter: string | null, collection: string | null): boolean {
      const badge = card.dataset.badge ?? '';

      if (category && card.dataset.category !== category) return false;
      if (filter === 'new' && badge !== 'New') return false;
      if (filter === 'bestseller' && badge !== 'Best Seller') return false;

      if (collection) {
        const members = collectionMembers[collection];
        // Collection without a data-backed membership rule -> show everything.
        if (members && !members.includes(card.dataset.id ?? '')) return false;
      }

      return true;
    }

    function applyFilters(): void {
      const params = new URLSearchParams(window.location.search);
      const category = params.get('category');
      const filter = params.get('filter');
      const collection = params.get('collection');

      let visible = 0;
      cards().forEach((card) => {
        const show = matches(card, category, filter, collection);
        card.classList.toggle('is-filtered-out', !show);
        if (show) visible += 1;
      });

      if (countEl) {
        countEl.textContent = `Showing ${visible} product${visible !== 1 ? 's' : ''}`;
      }
      emptyState?.classList.toggle('hidden', visible > 0);

      const activeKey = collection
        ? `collection:${collection}`
        : category
          ? `category:${category}`
          : filter
            ? `filter:${filter}`
            : 'all';
      setPillState(activeKey);

      const meta = filterMeta.find((entry) => entry.key === activeKey);
      if (meta) {
        if (headingEl) headingEl.textContent = meta.heading;
        if (subcopyEl) subcopyEl.textContent = meta.subcopy;
        const brand = headingEl?.dataset.siteName;
        if (brand) document.title = `${meta.heading} | ${brand}`;
      }
    }

    function applySort(): void {
      const value = sortSelect?.value ?? 'featured';
      const container = grid?.querySelector<HTMLElement>('[data-product-grid]');
      const all = cards();

      const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        featured: (a, b) => Number(a.dataset.order) - Number(b.dataset.order),
        newest: (a, b) => {
          const diff = Number(b.dataset.badge === 'New') - Number(a.dataset.badge === 'New');
          return diff !== 0 ? diff : Number(a.dataset.order) - Number(b.dataset.order);
        },
        'price-low': (a, b) => Number(a.dataset.price) - Number(b.dataset.price),
        'price-high': (a, b) => Number(b.dataset.price) - Number(a.dataset.price),
        bestselling: (a, b) => Number(b.dataset.reviews) - Number(a.dataset.reviews),
      };

      const compare = comparators[value] ?? comparators.featured;
      // Every card is reordered, not just the visible ones, so that changing a
      // filter never drops a card back into the wrong position.
      [...all].sort(compare).forEach((card) => container?.appendChild(card));
    }

    // Filter links navigate normally (the static page reloads and the script reads
    // the new query string). Sorting never reloads.
    sortSelect?.addEventListener('change', () => {
      const url = new URL(window.location.href);
      if (sortSelect.value === 'featured') {
        url.searchParams.delete('sort');
      } else {
        url.searchParams.set('sort', sortSelect.value);
      }
      window.history.replaceState({}, '', url);
      applySort();
    });

    const initialSort = new URLSearchParams(window.location.search).get('sort');
    if (initialSort && sortSelect) {
      const hasOption = Array.from(sortSelect.options).some((option) => option.value === initialSort);
      if (hasOption) sortSelect.value = initialSort;
    }

    applyFilters();
    applySort();
  </script>
</Layout>